---
import Layout from '@/layouts/default.astro'
import SuspensionBand from '@/components/suspension-band.astro'
import { socialMixerWhen, tournament } from '@/data/tournament'
import tvLogo from '@/assets/logo.svg'
import tsvLogo from '@/assets/tsv-winsen.png'
import { dayLabel, resolveSocialMixerBlock, SOCIAL_MIXER_DEFAULT_PLACEMENT } from '../../shared'

// The event's two days, in wire order — the same copy the client hands the view, needed here too because
// the mixer's band heads its own day in the delivered HTML (see the band below).
const viewDays = [tournament.saturday, tournament.sunday]

// The appointment as built: the block at its planned placement, on the single court a head-count of nothing
// earns. The page names its courts now (ADR-0073) and the real head-count is the server's, so this is the
// correct-without-JS default the one phase read below replaces — not the last word.
const defaultMixerBlock = resolveSocialMixerBlock({ ...SOCIAL_MIXER_DEFAULT_PLACEMENT, confirmed: 0 })!

// The public event-wide schedule + live board (ADR-0005, ADR-0032, ADR-0069, #91, #308): one page for the
// whole weekend that always shows the current truth, never the stale plan. While anything is on it leads
// with a „Jetzt auf dem Platz" courts board — the 6 courts, each showing what is live on it right now (or
// „frei"); with nothing running the board is absent altogether (#347), because it has no answer — over a
// schedule grouped **day → court** that marks the match on court right now („läuft" — the page's only badge,
// #327) and shows results for finished matches, and can be filtered by competition — the mixer included, as
// a field that carries no match and narrows the page to its own appointment (ADR-0074).
//
// The grouping is fixed, and the old „Nach Tag" / „Nach Platz" toggle stays gone (ADR-0071): the court is
// the column a player reads down to find their own afternoon, and „what is on right now" is the courts
// board's question anyway. Each court's first match carries a plain time („10:00"); everything that follows
// on that court carries „ca. 14:00", because a reservation is 90 minutes on average, not by rule.
//
// A match's court is the **actual** live court once running (the feed already falls back to the planned
// court before it starts), so a spectator is never sent to the wrong court. Built with the public site's
// inline-`<script>` + polling pattern (ADR-0008); every projection decision lives in shared/match-view.
//
// `headerSticky` (#349): this is the one page in the site read by scrolling a long board, so the bar
// carrying „← Zurück" stays put while the board scrolls under it.
---

<Layout title="Spielplan & Live — Winsener Meisterschaften 2026" chrome="legal" headerSticky>
  <div data-sheet class="mx-auto max-w-[900px] px-5 pt-12 pb-20 text-navy md:px-10 md:pt-16 md:pb-[120px]">
    <h1 class="mt-0 mb-3 text-[clamp(36px,6vw,56px)] font-black tracking-[-0.04em] uppercase">Spielplan &amp; Live</h1>

    <!-- Starts in the loading state so the board never paints a misleading empty „keine Spiele" grid before
         the first poll resolves — and if the inline script fails to load at all, this benign „lädt…" holding
         message stays put instead of a fake-empty board during a live event. The first successful render (or
         a failed poll) clears it. -->
    <!-- The Play suspension (ADR-0078). Above the Live board and outside `[data-board]`, because it is a
         statement about the whole page rather than a state of the board: the board's loading/error/unpublished
         classes must not be able to take it away, and a suspension is true even when the plan is withheld
         (ADR-0032 over ADR-0041). It also explains the „ca." this suspension puts on every not-yet-started
         row below — without this band that hedge would be unexplained. -->
    <SuspensionBand surface="schedule" />

    <!-- The two club crests the match row flies (#309), handed to the controller through the dataset: Astro
      fingerprints the bundled assets, so their URLs are the page's to know and never the render module's —
      the same wiring the participant list uses. -->
    <div data-board class="is-loading" data-logo-tv={tvLogo.src} data-logo-tsv={tsvLogo.src}>
      <p class="board-loading">Spielplan wird geladen …</p>
      <!-- The publish gate (ADR-0041): until the operator publishes and nothing is live yet, the planned
           schedule stays private and only this notice shows. A running/done match is live truth and is
           served + rendered even while unpublished, so the notice yields to it the moment any match arrives. -->
      <p class="board-unpublished">
        Der Spielplan ist noch nicht veröffentlicht. Sobald die Auslosung abgeschlossen ist, erscheinen hier alle
        Ansetzungen mit Platz und ungefährer Zeit — und am Wochenende, was gerade läuft.
      </p>
      <p class="board-error">Der Spielplan lässt sich gerade nicht laden. Bitte später erneut versuchen.</p>

      <!-- The live board is present only while something is live (#347), so heading and cells alike are the
           renderer's — a static `<h2>` here could not withdraw with them. Starts empty and hidden: with
           nothing running, the reader meets the schedule straight away. -->
      <section class="board-courts" aria-label="Jetzt auf dem Platz" data-courts hidden></section>

      <section class="board-schedule" aria-label="Spielplan">
        <div class="board-controls" data-controls>
          <!-- The mixer rides in here as a chip like any other, although it has no match to show (ADR-0074):
             the option is the controller's to supply, because the feed can never carry a field the engine
             models no match for. Its answer is the band below — see `placeMixerBand`. -->
          <div class="board-filter" data-filter aria-label="Konkurrenz filtern" role="group"></div>
        </div>

        <p class="board-empty">
          Noch keine Spiele geplant. Sobald die Auslosung läuft, erscheinen hier die Ansetzungen.
        </p>
        <div data-sections></div>
      </section>
    </div>

    <!-- The Social mixer's reserved court-time (ADR-0073, ADR-0064, ADR-0063): one **day-level band at the
         head of its own day's section**, stated once. It is the mixer's place on the grid — the field whose
         claim is „integration, not sideshow" was the only one not on it — and it is stated once rather than
         repeated down each reserved court's column, because a three-hour appointment printed twice reads as
         two events.
         It lives **outside** `[data-board]` in the delivered HTML and is moved into Sunday's section by the
         controller once that section exists: the band is neither the forward plan the publish gate hides
         (ADR-0041) nor live truth, so no board state (loading, error, unpublished) may take it away from the
         participants who have to be there. Built statically at the block's **default** placement and its
         default single court, so the page is right without JS; the operator may move the block and the real
         courts are only known to the server, so the one runtime read below patches this line — together with
         the cancellation (ADR-0062), off the single `/api/phase` signal all three ride (ADR-0048). Still no
         polling: an appointment does not change between polls, so it is read once on load. Fail-open, unlike
         the match feed's fail-closed reveal gate (ADR-0036), because the failure modes are not symmetric:
         withholding an appointment on a network blip is worse than briefly naming one court too few. -->
    <div data-mixer-home class="mixer-home">
      <!-- The band's own day heading, for the states where its day has no section to head: nothing
           published yet, a reset plan, a failed poll. It reads „Sonntag · 23.08." exactly as the schedule's
           day heading does — same helper, same words — so the appointment is read as a line inside its day
           in every state rather than as a loose card at the foot of the page. Hidden the moment the real day
           section exists and the band moves into it, so the day is never headed twice. -->
      <h2 class="sched-day__head" data-mixer-day>{dayLabel(viewDays, defaultMixerBlock.day)}</h2>
      <section data-mixer class="mixer-band">
        <h3 class="mixer-band__field">Damen Doppel</h3>
        <p class="mixer-band__when" data-mixer-when>{socialMixerWhen(defaultMixerBlock)}</p>
        <p class="mixer-band__note">
          Geselliger Doppel-Spieltag mit wechselnden Partnerinnen — kein Turnierbaum, kein Ergebnis. Die Einteilung
          macht die Spielleiterin vor Ort; komm einfach zur angegebenen Zeit an die Plätze.
        </p>
      </section>
    </div>
    <!-- The „ca." convention, moved off the top of the page (ADR-0072, #351). It used to be a sentence
         plus an eight-line disclosure above the first match, on a page whose one job is „wann spiele ich".
         ADR-0071 is what makes the foot safe: the number carries its own hedge at the point of reading
         („ca. 14:00"), so nothing above needs a preamble — only the reader who wants the convention spelled
         out comes looking, and by then they are at the end.
         Plain prose rather than a `<details>`: at the foot, length costs nothing, and a reader who scrolled
         this far is looking for exactly this — so there is nothing left to defer. „läuft" and the result are
         not explained: the board says both, and neither word was ever confusing.
         The last sentence used to read „Früher fängt also nichts an, später schon", and it was **untrue**:
         a match can be called early when its court comes free. What the planned time actually is, is the
         point the organisers aim at — an anchor, not a floor — so the note says that instead (ADR-0075).
         The correction runs one way only: a reader who was promised „never earlier" and turns up on that
         promise has already missed the match, which is the one failure this page must not cause. -->

    <section class="time-note">
      <h2 class="board-heading time-note__head">Was heißt „ca."?</h2>
      <p class="time-note__body">
        Das erste Match auf einem Platz hat eine <strong>feste Zeit</strong> — davor liegt nichts, was es verschieben könnte.
        Alle weiteren stehen mit <strong>„ca."</strong>: sie fangen an, wenn das Match davor auf diesem Platz fertig
        ist. Pro Match sind 90 Minuten reserviert, und das ist ein Erfahrungswert, keine Regel. Die Turnierleitung
        orientiert sich dabei an den geplanten Zeiten — es kann aber auch etwas früher losgehen.
      </p>
    </section>
  </div>
</Layout>

<style is:global>
  /* ── Foot note („ca.") ────────────────────────────────────────────────────────────────────────── */
  /* Quiet on purpose, and quiet by reuse: the heading *is* the page's small-caps section label, dropped to
     the same muted navy as the prose so it reads as an aside under the board rather than as another section
     of it, and the paragraph shares the mixer note's rule — one explanatory-prose style for the page, stated
     once. The rule above is what separates the note from the board: the board ends, then this. */
  .time-note {
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
  }
  .time-note__head {
    margin-bottom: 10px;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }

  /* ── State visibility ─────────────────────────────────────────────────────────────────────────── */
  /* The initial loading state (before the first poll, or if the script never runs): hide the whole board
     and every notice, show only „lädt…". Cleared by the first successful render or a failed poll. */
  .board-loading {
    display: none;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  [data-board].is-loading .board-loading {
    display: block;
  }
  [data-board].is-loading .board-courts,
  [data-board].is-loading .board-schedule,
  [data-board].is-loading .board-unpublished,
  [data-board].is-loading .board-error {
    display: none;
  }

  .board-error,
  .board-unpublished {
    display: none;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  /* Error wins over everything: hide the whole board (and the „noch nicht veröffentlicht" notice, which a
     prior successful poll may have left showing — render() only runs on success, so a failed poll adds
     `is-error` without clearing `not-published`), show only the error. */
  [data-board].is-error .board-courts,
  [data-board].is-error .board-schedule,
  [data-board].is-error .board-unpublished {
    display: none;
  }
  [data-board].is-error .board-error {
    display: block;
    font-size: 14px;
  }
  /* Unpublished with nothing live: hide the board, show the „noch nicht veröffentlicht" notice. */
  [data-board].not-published .board-courts,
  [data-board].not-published .board-schedule {
    display: none;
  }
  [data-board].not-published .board-unpublished {
    display: block;
  }
  /* The competition filter only means anything once there are matches. */
  [data-board]:not(.has-matches) .board-controls {
    display: none;
  }
  /* The empty note shows only when published-but-empty (no matches, but past the publish gate). */
  .board-empty {
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  [data-board].has-matches .board-empty,
  [data-board].not-published .board-empty,
  [data-board].is-error .board-empty {
    display: none;
  }

  /* The Social mixer's fixed appointment (ADR-0073, ADR-0063): a calm band at the head of its day, as wide
     as the day is — which is the opposite of a side-court footnote — and deliberately not styled as a match
     row, because it is an appointment and not an ansetzung. It sits above the day's court columns, so its
     top margin is the day heading's and its bottom margin is the gap before „Platz 1". */
  /* The band's fallback home, carrying its day heading — see the markup. Spaced like a day section, because
     in this state it is the only thing standing where a day section would be. */
  .mixer-home {
    margin-top: 44px;
  }
  .mixer-home[hidden] {
    display: none;
  }
  .mixer-band {
    margin: 14px 0 0;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
    background: color-mix(in srgb, var(--color-navy) 3%, transparent);
  }
  .mixer-band[hidden] {
    display: none;
  }
  /* Quieter than the day heading and louder than a court's: the band is one field inside the day, and the
     line under it is the fact the reader came for. */
  .mixer-band__field {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  .mixer-band__when {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .mixer-band__note,
  .time-note__body {
    margin: 0;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }

  .board-heading {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  /* ── Courts board („Jetzt auf dem Platz") ─────────────────────────────────────────────────────── */
  .board-courts {
    margin-bottom: 44px;
  }
  /* A fixed column count rather than `auto-fit`, because the number of courts is a fact about the club, not
     about the viewport: `minmax(150px, 1fr)` fitted 5 across and left the sixth court stranded on a row of
     its own, which reads as a broken grid rather than as six courts. 2 then 3 columns divide 6 evenly, and
     three wider cards hold „Steffen Brettschneider" where five narrow ones truncated it. */
  .courts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media (min-width: 640px) {
    .courts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .court {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 104px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 14%, transparent);
    background: color-mix(in srgb, var(--color-navy) 2%, transparent);
    transition: opacity 0.15s ease;
  }
  /* A court running a match wears the brand accent and a filled left rail; an empty one stays quiet
     (ADR-0072 rule 3). Two signals for one fact, on purpose: the wash says „live" in colour, the rail says
     it without — 4px of ink against the idle cell's hairline is still there in greyscale and for a
     colourblind reader, which a green tint alone never was.
     The rail is a **border**, and that is the whole reason it is not the tidier `box-shadow: inset` (which
     would have followed the radius and cost no padding compensation): a forced-colours mode — Windows High
     Contrast, the same class of override `color-scheme: only light` already guards the page against — drops
     shadows and repaints backgrounds, so a shadow rail would take the non-colour signal with it in the one
     mode a reader turns on *because* they need contrast. A border is kept and recoloured. The left padding
     pays for the extra 3px, so a live cell's content sits where a free cell's does.
     No transition: a cell that goes live is re-rendered, not animated. */
  .court--live {
    background: color-mix(in srgb, var(--color-live) 22%, transparent);
    border-left: 4px solid var(--color-navy);
    padding-left: 11px;
  }
  /* When a competition filter is active, courts that are not the focused field fade back — never blanked
     to „frei" (that would lie about a physically busy court), just de-emphasised (ADR-0032: stay truthful). */
  .court--dim {
    opacity: 0.4;
  }
  .court__no {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  /* Full-strength ink on a live cell: there the eyebrow heads a match rather than labelling an empty box.
     The accent cannot take this job — lime is a fill, not a text colour. */
  .court--live .court__no {
    color: var(--color-navy);
  }
  .court__free {
    margin: auto 0;
    font-size: 15px;
    font-weight: 700;
    color: color-mix(in srgb, var(--color-navy) 35%, transparent);
  }
  /* A live court a partial suspension has stopped (ADR-0078 Amendment 2 rule 5). The live wash comes off and
     the rail turns clay — the suspension band's own colour, so the cell and the statement above it read as
     one fact — while the match's own content stays exactly where it was. Two signals again, for the same
     reason `.court--live` carries two: the rail survives greyscale and forced colours, where a tint does
     not, and the „unterbrochen" line says it in words either way. */
  .court--stopped {
    background: color-mix(in srgb, var(--color-clay) 12%, transparent);
    border-left-color: var(--color-clay);
  }
  .court__stopped {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .court__players {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .court__meta {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }

  /* ── Controls (competition filter + grouping toggle) ──────────────────────────────────────────── */
  .board-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 26px;
  }
  .board-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* The same chip the front door already had (ADR-0076). Its inactive fill is `navy 6%` — byte-identical
     to the format chips on the competition cards (`bg-navy/[0.06]`), at the same size, weight and tracking.
     The only thing that ever differed was the shape: a pill here against a rectangle there, which read as
     two components rather than one. Squared, it *is* that chip. */
  .board-chip {
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-navy) 65%, transparent);
    background: color-mix(in srgb, var(--color-navy) 6%, transparent);
    border: 1px solid transparent;
    cursor: pointer;
  }
  .board-chip.is-active {
    color: var(--color-text-inverted);
    background: var(--color-navy);
  }
  /* ── Schedule sections (day → court) ──────────────────────────────────────────────────────────── */
  .sched-day {
    margin-top: 44px;
  }
  .sched-day:first-child {
    margin-top: 0;
  }
  .sched-day__head {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
    border-bottom: 2px solid var(--color-navy);
    padding-bottom: 6px;
  }
  /* The day a reader is looking at stays named while they scroll it, and is pushed off by the next day's
     heading — a long board is scrolled far past the point where „Samstag oder Sonntag" is still obvious.
     Pinned **below** the page's own pinned bar (#349), which is why its height is a variable rather than a
     number repeated here; the `z-index` stays under that bar's 50 so the two stack in reading order rather
     than fighting. Opaque, for the same reason the bar is: rows scroll underneath it.
     Scoped to the day **section's** heading, because the same class also heads the mixer band's fallback
     home (see the markup) — that one is a card's heading at the foot of the page and has nothing to pin
     itself to. The court heading deliberately does not join in: three pinned layers on a phone is most of
     the viewport, and the court is the quieter of the two headings on purpose. */
  .sched-day > .sched-day__head {
    position: sticky;
    top: var(--site-header-legal-h);
    z-index: 20;
    padding-top: 8px;
    background-color: var(--color-surface);
  }
  /* While a suspension stands, the day heading stands down (ADR-0078 rule 8 as amended). The band pins below
     the bar, so keeping this pinned too would make three layers — the exact count the comment above refuses
     for the court heading, and it would be most of a phone viewport for as long as the rain lasts. The
     heading stays perfectly legible in flow on the way past, and „when does play continue" outranks „which
     day am I looking at" for precisely the period the band is up. */
  :root.is-play-suspended .sched-day > .sched-day__head {
    position: static;
  }
  /* The three vertical gaps inside a day are a **ranked set**, and the numbers are chosen against each other
     rather than each on its own (ADR-0075 rule 4): 8px between two cards on the same court, 22px at a block
     boundary within a court, 36px between two courts — on top of which only the court gets a heading and a
     rule. A block boundary that out-measured a court boundary would say the chain matters more than the
     column, which is the inversion this change exists to undo. */
  .sched-court {
    margin-top: 36px;
  }
  /* The court is the unit a spectator reads down — top to bottom is the order of play on that court, and
     the frame in which a „ca." earns its hedge. It used to whisper: 55% navy at 12px, on the reasoning that
     the day is the section and the court is merely the column inside it. **ADR-0075 reverses that.** The
     hierarchy was real in the view model and invisible on the screen, so the page read as one long list and
     the grouping a player is meant to read down had to be inferred. The heading now owns its column in full
     ink, with a rule under it — and the loudness is bought with **ink and a rule, never with size**: it
     stays at the day heading's 12px, because a court heading that outgrew its day would invert the very
     hierarchy this change exists to state. What keeps it a rank below is everything else — no uppercase, a
     1px rule against the day's 2px, and it stays out of the sticky stack (three pinned layers on a phone is
     most of the viewport, and that reason has not expired). */
  .sched-court__head {
    margin: 0 0 10px;
    padding-bottom: 5px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    border-bottom: 1px solid color-mix(in srgb, var(--color-navy) 18%, transparent);
  }
  /* Time · contestants · status. The time column now holds at most „ca. 14:00" on one line (ADR-0071), so it
     is narrower than the two-line floor needed — the names get the width back. The status column is
     **implicit** (two declared tracks, flow by column), because only a running match carries a badge (#327):
     a third declared track would hold a 12px gap open on every other row, reserving space for nothing. */
  .sched-match {
    display: grid;
    grid-template-columns: 68px 1fr;
    grid-auto-flow: column;
    align-items: center;
    gap: 12px;
    padding: 0 4px;
    margin-bottom: 8px;
  }
  /* The block boundary (ADR-0075). Within a court, a card whose time is anchored opens a fresh block: it is
     either the first match of the day there or the first after a gap in the reservation chain, and either
     way its „HH:MM" is a fact rather than an estimate (ADR-0071). That break is worth seeing, and the fact
     is already in the DOM as the time's own class — read here with `:has` rather than asking the renderer
     for a second hook, the way the „läuft" rail reads the badge.
     Deliberately **only** a gap, not a rule across the column: the boundary must stay a rank below the court
     heading, or the grouping the heading was just made loud enough to state gets torn up again by a second
     divider competing with it. Neutralised on the column's first card, where the heading is the boundary.
     The number is the **whole** gap, not an addition to the 8px below the card before it: adjacent in-flow
     margins collapse to the larger of the two, so this reads against that 8px rather than on top of it. */
  .sched-match:not(:has(.sched-match__time--follows)) {
    margin-top: 22px;
  }
  .sched-court__head + .sched-match {
    margin-top: 0;
  }
  .sched-match__time {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    color: var(--color-blue);
  }
  /* A follow-on time is a weaker claim than a court's first match, and it reads that way. The „ca." carries
     that in two characters; this carries it a second time, for a phone in bright sunlight.
     The gap widens under ADR-0075, but only on **weight**: with the rows now cards, this contrast also marks
     a block boundary, so it has to read at a glance rather than on comparison. The tint stays where it was.
     Fading it further was tried and reverted — a follow-on time is the *common* case on a court, so dimming
     it to sharpen a boundary would have spent the legibility of most of the column's times on a signal the
     wider gap above already carries. The weakening a hedge deserves is a lighter weight, not fainter ink. */
  .sched-match__time--follows {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
  }
  /* The two contestant lines share **one** grid — identity · sets · outcome — so the sets line up down a
     column between them, which is the reference tournaments' single most useful habit. A grid per line
     would not do it: „· Aufg." on the winner's line would widen only that line and shove its sets left,
     breaking the column on exactly the case the outcome token introduces. The lines dissolve into this
     grid (`display: contents`) and keep their element only as the hook the winner/tbd rules select on. */
  /* This grid is also **the card** (ADR-0075). Roland-Garros' order of play is what prompted it, and the
     card is where the borrowing stops: it is a **boundary**, saying where one match ends, and not a
     destination. So a border, and none of the things that promise a tap — no fill, no shadow, no hover
     lift, **and no radius** — because there is nowhere for a tap to go. The radius was rule 3's own
     exception and ADR-0076 closed it: a rounded rectangle is the single strongest tappability cue this
     stylesheet had, so the one property the rule kept was the one working against it.
     It wraps the contestants, their sets and the meta line only: the time stays outside it in the left
     gutter and the „läuft" badge in the right one, so the column keeps a straight edge of times to read
     down. Roland-Garros can afford the time inside the card because only its first match of a block carries
     one; every card here has a time (ADR-0071), which is exactly what makes the gutter worth keeping. */
  .sched-match__players {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: 10px;
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 14%, transparent);
  }
  .sched-match__players .sched-match__player {
    display: contents;
  }
  .sched-match__players .sched-match__meta {
    grid-column: 1 / -1;
  }
  /* The courts board reuses the contestant line outside that grid, where it stays a plain flex row. */
  .sched-match__player {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  /* The one place the two surfaces genuinely want opposite things (#343). In the grid above, an outcome
     cell must exist even when it holds nothing, or everything after it slides one cell along — so the
     renderer emits it unconditionally. Here, `space-between` distributes by item count, and a third,
     empty item would pull the sets away from the right edge toward the middle of the cell. Hence the
     suppression, and hence it is **scoped to the courts board**: applied globally, `:empty` would take
     the grid item back out and bring the shift straight back. */
  .court__players .sched-match__outcome:empty {
    display: none;
  }
  /* Crest · name · seed · check, in the order a tennis reader expects them (#309). */
  .sched-match__ident {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  /* The club crest, in place of the country flag the references fly — we have no nations, but we do have
     clubs, and that is what this audience reads. Same white disc as the participant list's avatar. */
  .sched-match__crest {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .sched-match__crest img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sched-match__name {
    min-width: 0;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The seed rides small and muted behind the name — the references keep exactly this slot for it, so the
     number never competes with the person. */
  .sched-match__seed {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }
  /* The winner's second mark. Bold alone loses on a phone in the sun, so the check carries the result
     redundantly — a tick, never a tinted row. */
  .sched-match__check {
    flex-shrink: 0;
    font-size: 12px;
    line-height: 1;
    color: var(--color-blue);
  }
  .sched-match__player--tbd .sched-match__name {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }
  /* The winner of a finished match reads bold — the primary result signal on the board. */
  .sched-match__player--winner .sched-match__name {
    font-weight: 800;
  }
  /* Right-aligned within its column, so the sets read down a column between the two lines. */
  /* `tabular-nums` below is load-bearing rather than a nicety: `scoreLine` pads every entry to a digit-wide
     column with U+2007 FIGURE SPACE, and a figure space is only a digit wide in tabular figures. Drop it and
     the two lines' sets slide out of column again the moment a Match-Tie-Break makes one line's entries
     wider than the other's. */
  .sched-match__games {
    flex-shrink: 0;
    justify-self: end;
    text-align: right;
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
  }
  .sched-match__player--winner .sched-match__games {
    color: var(--color-navy);
  }
  /* „· Aufg." / „w.o." — the outcome where the score is, terse and quiet beside the sets it qualifies. Its
     own column, so it never widens the sets' one and never shifts them out of line. */
  .sched-match__outcome {
    flex-shrink: 0;
    justify-self: end;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  .sched-match__meta {
    margin-top: 3px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }
  /* Out of flow, in the card's bottom-right corner (ADR-0075). It used to be a grid item in an implicit
     third column, which was right while the rows were separated by hairlines: an unbadged row simply did
     not open the track. With the rows now cards that track became visible as a **narrower card on the one
     running match** — a ragged right edge down the column, and the row a reader is hunting for clipping its
     name earlier than its neighbours. Taking the badge out of flow gives every card the same width, and it
     lands inside the frame rather than beside it, in the space the meta line leaves empty. The meta reserves
     room for it only on the row that has one, so no other row pays. */
  .sched-status {
    position: absolute;
    right: 14px;
    bottom: 10px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
  }
  /* „läuft" is the only badge the page prints, so it is the only one tinted — a planned or finished row
     appends no status element at all, and the quiet grey pills those two used to wear are gone with them.
     It is tinted with the **brand accent** (ADR-0072 rule 3), filled, navy ink on it — the pairing the
     signup CTA the lime comes from already used. */
  .sched-status--running {
    color: var(--color-navy);
    background: var(--color-live);
  }
  /* The rail: the half of the „läuft" signal that is not colour. A live row carries a filled bar in the
     sheet's gutter as well as the badge, so live-versus-planned survives greyscale.
     Three things it deliberately is not:
     — not a class of its own — the badge already *is* the „is this running" fact, so `:has` reads it there
       rather than having the renderer emit a second hook for one status (#304 keeps it a translation);
     — not inside the row's padding — a rail paid for out of that would step the time column right on the
       one row a reader is hunting for, so it is drawn out of flow into the gutter and moves nothing. Out of
       flow also keeps it out of the row's grid, which would otherwise place it as an item;
     — not animated — the accent and the rail already say it, and motion would owe a reduced-motion branch.
     A zero-width box wearing a 4px border, rather than a 4px box wearing a background, for the reason the
     Live board cell's rail gives: a forced-colours mode repaints backgrounds and would erase a painted bar,
     while a border is kept and recoloured. Same rail, same reason, on both surfaces. */
  .sched-match:has(.sched-status--running) {
    position: relative;
  }
  /* The badge sits over the meta line's tail, which is empty on every row this project produces — but only
     because the meta is short, not because anything guarantees it. This buys the guarantee, on the one row
     that needs it. */
  .sched-match:has(.sched-status--running) .sched-match__meta {
    padding-right: 56px;
  }
  .sched-match:has(.sched-status--running)::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -8px;
    border-left: 4px solid var(--color-navy);
  }

  /* ── Print ────────────────────────────────────────────────────────────────────────────────────── */
  /* The paper copy at the results desk (#310). A stylesheet, not a PDF generator: the browser already
     renders this page, and a generator would be new infrastructure for one button. What goes on paper is
     the plan — day sections, court columns, time, contestants, score — and nothing that only works on a
     screen. Everything below is the same DOM as the screen, so a change to the row anatomy lands here too.

     Deliberately dropped: the site chrome (a nav bar is not a sheet), the competition filter (an
     interaction control prints as a lie — the chips look pressable and nothing happens), and the
     „Jetzt auf dem Platz" board, which is true for the minute it was printed and misleading from then on.
     The Social mixer's appointment stays: it is a fixed date, and paper is exactly where a date belongs, and
     so does the „ca." note at the foot — a sheet of approximate times has to say so somewhere. */
  @media print {
    @page {
      margin: 14mm;
    }

    /* No chrome and no controls on the sheet. */
    .skip-link,
    header,
    footer,
    .board-controls {
      display: none !important;
    }
    /* The „ca." note prints, and now needs no unfolding to do it: it is prose, not a disclosure. It stays at
       the foot — a sheet full of „ca. 14:00" is exactly the sheet whose reader wants the convention, and the
       end of the sheet is where they look for it. Sized in pt like every other line here, and kept off a
       sheet of its own. */
    .time-note {
      margin-top: 14pt;
      padding-top: 8pt;
      border-top-color: #000;
      break-inside: avoid;
    }
    .time-note__head {
      font-size: 9pt;
      color: #000;
    }
    /* The live board is a snapshot; on paper it is stale before the page leaves the printer. */
    .board-courts {
      display: none !important;
    }

    /* Ink is expensive and the page tints are decoration: black text on white paper, the whole way down.
       No `print-color-adjust` anywhere — the tinted status pills and court cards are meant to drop out. */
    [data-sheet] {
      max-width: none;
      padding: 0;
      color: #000;
    }
    [data-sheet] h1 {
      font-size: 24pt;
      margin-bottom: 6pt;
    }
    .mixer-band {
      margin: 6pt 0 12pt;
      padding: 8pt 10pt;
      background: none;
      border-color: #000;
      break-inside: avoid;
    }
    .mixer-band__field {
      font-size: 8.5pt;
      color: #000;
    }
    .mixer-band__when {
      font-size: 11pt;
    }
    .mixer-band__note,
    .time-note__body {
      font-size: 8.5pt;
      color: #000;
    }

    /* A day starts a fresh sheet from the second one on, and a heading never prints alone at a page foot. */
    .sched-day {
      margin-top: 0;
      break-before: page;
    }
    .sched-day:first-child {
      break-before: auto;
    }
    .sched-day__head,
    .sched-court__head {
      break-after: avoid;
      color: #000;
    }
    .sched-day__head {
      font-size: 11pt;
      border-bottom-color: #000;
    }
    /* Paper does not scroll, so the pinned heading goes back into flow — a sticky box in a paged context is
       at best a no-op and at worst a heading printed on every sheet. */
    .sched-day > .sched-day__head {
      position: static;
      padding-top: 0;
    }
    .sched-court {
      margin-top: 14pt;
      break-inside: avoid;
    }
    .sched-court__head {
      font-size: 10pt;
      border-bottom-color: #000;
    }

    /* No row is ever cut in half by a page break, and none of its parts is cut off by the box either:
       a name that no longer fits wraps onto a second line rather than ending in an ellipsis.
       **The card is a screen decision and is undone here** (ADR-0075). Six framed boxes per court is white
       space the sheet at the results desk cannot spend — it would push the posted sheet onto a second page for a
       boundary that a hairline states just as well on paper, where nothing scrolls and the eye has the whole
       court in view at once. So the frame goes back to a rule under the row, and the block boundary keeps a
       gap in front of it: half the screen's, which is all a stationary page needs. */
    .sched-match {
      break-inside: avoid;
      padding: 5pt 0;
      margin-bottom: 0;
      border-bottom: 0.5pt solid rgba(0, 0, 0, 0.35);
    }
    .sched-match:not(:has(.sched-match__time--follows)) {
      margin-top: 8pt;
    }
    /* Repeated inside the query, not inherited from the screen rule: that one has the same specificity and
       loses on source order to the line above, which would put a block gap above every court's first row —
       the one place the heading is already the boundary. */
    .sched-court__head + .sched-match {
      margin-top: 0;
    }
    .sched-match__players {
      padding: 0;
      border: none;
    }
    .sched-match__time,
    .sched-match__time--follows {
      font-size: 9pt;
      font-weight: 700;
      color: #000;
    }
    .sched-match__name {
      font-size: 10pt;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .sched-match__seed,
    .sched-match__games,
    .sched-match__outcome,
    .sched-match__meta {
      color: #000;
    }
    .sched-match__player--tbd .sched-match__name {
      color: #000;
    }
    .sched-match__check {
      color: #000;
    }
    /* The status keeps its word and loses its pill — the tint is what carried it on screen. The rail goes
       with the tint: „läuft" is true for the minute the sheet was printed, and a bar in the margin would
       still be claiming it an hour later.
       It also goes back **into the flow**, at the row's end: out-of-flow placement exists to stop the badge
       narrowing a card, and on paper there is no card for it to narrow — while an absolute box on a row a
       page break may move is a way to print one word on top of another. */
    .sched-status {
      position: static;
      justify-self: end;
      padding: 0;
      background: none !important;
      color: #000 !important;
    }
    .sched-match:has(.sched-status--running) .sched-match__meta {
      padding-right: 0;
    }
    /* Selected exactly as on screen, `:has` included: `:has()` carries the specificity of its argument, so
       a plain `.sched-match::before` here would lose to the screen rule and print the bar anyway. */
    .sched-match:has(.sched-status--running)::before {
      content: none;
    }
  }
</style>

<script>
  import { hc } from 'hono/client'
  import {
    dayLabel,
    NOT_SUSPENDED,
    scheduleView,
    socialMixerBlockOn,
    SOCIAL_MIXER_COMPETITION,
    SOCIAL_MIXER_DEFAULT_PLACEMENT,
    suspendedCourts
  } from '../../shared'
  import { renderCourts, renderFilter, renderSchedule } from '../components/schedule-board.render'
  import { renderSuspensionBand } from '../scripts/suspension-band'
  import { competitions, eventDayAt, socialMixerWhen, tournament } from '../data/tournament'
  import type { AppType } from '../../worker/app'
  import type { PlaySuspension, ScheduleResponse } from '../../shared'

  // The public schedule board's controller: fetch → state → poll → project → render. Every decision lives
  // in `scheduleView` (shared/match-view) and all the DOM building in ../components/schedule-board.render;
  // this script only keeps the feed and the one view control, and decides when to hand them over.
  const client = hc<AppType>(location.origin)

  // The two pieces of client copy the projection needs as data: the event's dates and the competition
  // labels. They stay here, with the rest of the event's copy — `shared/` must not reach into src/data, so
  // the page hands them over rather than the module importing them.
  const VIEW_COPY = {
    days: [tournament.saturday, tournament.sunday],
    competitions: competitions.map(c => ({ slug: c.slug, label: c.label }))
  }

  // The live board polls ~15 s (ADR-0008): a started match, a moved court, or a completed result appears
  // within the interval, light enough for a phone on event Wi-Fi.
  const POLL_MS = 15000

  const root = document.querySelector<HTMLElement>('[data-board]')
  const courtsEl = root?.querySelector<HTMLElement>('[data-courts]') ?? null
  const filterEl = root?.querySelector<HTMLElement>('[data-filter]') ?? null
  const sectionsEl = root?.querySelector<HTMLElement>('[data-sections]') ?? null

  // The mixer's band and the place it was delivered in. The band belongs at the head of its own day's
  // section (ADR-0073), but those sections only exist once the plan is published and rendered — so the band
  // ships outside the board and moves into its day whenever that day is on the page, and moves back out
  // whenever it is not. Its participants have an appointment either way (ADR-0063 §3).
  const mixerEl = document.querySelector<HTMLElement>('[data-mixer]')
  const mixerHomeEl = document.querySelector<HTMLElement>('[data-mixer-home]')

  // The crest URLs off the dataset (see the markup above). Empty strings are unreachable in practice; a
  // missing crest would render a broken image, never break the board.
  const LOGOS = { tv: root?.dataset.logoTv ?? '', tsv: root?.dataset.logoTsv ?? '' }

  // The competition filter lives in the URL (#310): a reload on the grounds keeps the field the spectator
  // picked, and „hier ist der Spielplan der Herren" becomes a link somebody can send. English key and
  // value — this is a wire value and the slugs already read `mens`/`womens`; the route slug stays German,
  // which ADR-0028 permits exactly here. An unknown or cancelled field needs no handling of its own: the
  // view drops a selection it does not offer, so the page degrades to „Alle" and says nothing about it.
  const FILTER_PARAM = 'competition'

  // Only a click writes the address back. The view's verdict is about the feed of *this* poll — an
  // unpublished or freshly reset plan carries no fields at all, so every selection degrades to „Alle" —
  // and letting that rewrite the URL would quietly strip a link somebody shared before the plan came back.
  const writeFilterToUrl = (slug: string | null) => {
    const url = new URL(location.href)
    if (slug === null) url.searchParams.delete(FILTER_PARAM)
    else url.searchParams.set(FILTER_PARAM, slug)
    history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`)
  }

  // The last-served feed plus the one view control. The filter re-renders from the cached feed (no
  // refetch), so changing it is instant; the poll only replaces `feed` and re-renders.
  let feed: ScheduleResponse = { published: false, matches: [] }
  // The competition slug, or null = „Alle" — seeded from the URL, so the very first render is already the
  // view the link promised.
  let selectedCompetition: string | null = new URL(location.href).searchParams.get(FILTER_PARAM)

  // The day the mixer's band belongs in: the operator's, once the one phase read lands, and the planned
  // placement's until then — the same day the band was built naming.
  let mixerDay: number = SOCIAL_MIXER_DEFAULT_PLACEMENT.day

  // Whether the mixer takes place, and with it whether the filter offers it as a field (ADR-0074). Starts
  // `true` for the same reason the band ships visible: the appointment is stated without JS and the phase
  // read is what takes it away, so the failure mode of a lost read is „the chip is offered" and never „the
  // participants cannot find their own slot" — fail-open, like everything else on that read (ADR-0063 §3).
  let mixerTakesPlace = true

  // Whether play is suspended (ADR-0078). Starts „play is happening" — the safe default and the one a failed
  // phase read leaves standing: a suspension is the operator's explicit statement, so the site must never
  // announce one nobody declared. The band and the schedule's hedge both read this.
  let playSuspension: PlaySuspension = NOT_SUSPENDED
  const suspensionEl = document.querySelector<HTMLElement>('[data-suspension]')

  // Put the band at the head of its day: after that day's heading, above its first „Platz N" column. The
  // day section is re-created on every render, so the band is re-inserted on every render too — and when
  // its day is not on the page (nothing published, a failed poll, or the plan reset) it goes back to where
  // it was delivered, which carries a day heading of its own so the appointment still reads as a line inside
  // its day. Stated **once** either way: one element, moved rather than copied, and exactly one of the two
  // day headings is ever showing.
  const placeMixerBand = () => {
    if (!mixerEl || !mixerHomeEl) return
    const head = sectionsEl?.querySelector(`.sched-day[data-day="${mixerDay}"] > .sched-day__head`) ?? null
    if (head) head.after(mixerEl)
    else mixerHomeEl.append(mixerEl)
    mixerHomeEl.hidden = head !== null
  }

  const render = () => {
    if (!root) return
    // The first render replaces the initial „lädt…" holding state with the real one.
    root.classList.remove('is-loading')
    const { published, matches } = feed
    root.classList.toggle('not-published', !published && matches.length === 0)
    root.classList.toggle('has-matches', matches.length > 0)

    const {
      competitions: options,
      selected,
      courts,
      days
    } = scheduleView(feed, {
      ...VIEW_COPY,
      competition: selectedCompetition,
      socialMixer: mixerTakesPlace,
      // Read at render time rather than at poll time, so a resume time that passes between two polls stops
      // being claimed on the next render either way (ADR-0078 rule 7). A list rather than a flag since
      // Amendment 2: only the courts the operator actually stopped hedge.
      stoppedCourts: suspendedCourts(playSuspension, Date.now()),
      // The day the reader is standing in leads the board (ADR-0081), off the **server's** clock on this
      // very feed rather than the device's. Read here rather than at poll time for the same reason
      // `stoppedCourts` is: a page left open across midnight then reorders itself on the next render
      // instead of holding a day it decided once.
      currentDay: eventDayAt(feed.now)
    })
    // The view decides whether the stored selection still applies (a field the feed stopped carrying, or a
    // page with nothing left to choose between), so the controller adopts its verdict rather than holding
    // on to a selection the page no longer offers.
    selectedCompetition = selected

    renderFilter(filterEl, options, selected, slug => {
      selectedCompetition = slug
      writeFilterToUrl(slug)
      render()
    })
    renderCourts(courtsEl, courts, LOGOS)
    renderSchedule(sectionsEl, days, LOGOS)
    placeMixerBand()
    renderSuspensionBand(suspensionEl, playSuspension, Date.now(), 'schedule')
  }

  let lastJson = ''
  const load = async () => {
    if (!root) return
    try {
      const res = await client.api.schedule.$get()
      if (!res.ok) throw new Error('bad status')
      const body: ScheduleResponse = await res.json()
      root.classList.remove('is-error')
      // Skip the rebuild when nothing changed since the last poll — the publish flag is part of the
      // signature so a publish/reset toggles the page on the next poll. The filter bypasses this (it calls
      // render() directly), so changing it is always instant.
      const sig = JSON.stringify({ published: body.published, matches: body.matches })
      if (sig === lastJson) return
      lastJson = sig
      feed = { published: body.published, matches: body.matches }
      render()
    } catch {
      // A failed poll clears the loading state too, so a first-poll failure shows the error, not „lädt…".
      root.classList.remove('is-loading')
      root.classList.add('is-error')
    }
  }

  let timer: ReturnType<typeof setInterval> | undefined
  const start = () => {
    if (timer === undefined)
      timer = setInterval(() => {
        void load()
        // The phase signal rides the same tick (ADR-0078): the suspension has to reach a page somebody left
        // open, and giving it a timer of its own would be a second cadence for one poll's worth of work.
        void applyPhaseState()
      }, POLL_MS)
  }
  const stop = () => {
    if (timer !== undefined) {
      clearInterval(timer)
      timer = undefined
    }
  }

  // The `/api/phase` signal, and the one place this page reads it. Four facts ride it: whether the mixer
  // still takes place (ADR-0062), where its block sits (ADR-0064), which courts its head-count earns
  // (ADR-0073 — the count itself is not public, so the wire carries the resolved list), and whether **play
  // is suspended** (ADR-0078). All of them fail open: a failed read leaves the built line standing and
  // leaves play reading as happening, rather than withholding or inventing (see the markup).
  //
  // **This is polled, not read once** — the ADR-0078 change. An appointment does not need polling and the
  // mixer facts were the whole payload before; a suspension does, because it is declared and lifted *while*
  // someone has this page open, and that spectator is exactly who the band exists for. It rides the board's
  // own 15s timer rather than one of its own: same cadence, one signal, no second clock to reason about.
  const applyPhaseState = async () => {
    try {
      const res = await client.api.phase.$get()
      if (!res.ok) return
      const { cancelledCompetitions, socialMixerPlacement, socialMixerCourts, playSuspension: next } = await res.json()

      // The suspension is independent of the mixer's band — it applies even when this page carries no mixer
      // element at all — so it lands before every early return below.
      const changed = JSON.stringify(next) !== JSON.stringify(playSuspension)
      playSuspension = next
      // The band is repainted on every poll, not only on a change: a resume time can pass between two polls
      // without the state changing at all, and that is exactly when the line has to go (ADR-0078 rule 7).
      // It is painted here rather than left to `render()` because the band is not part of the board and must
      // not depend on the board being renderable.
      renderSuspensionBand(suspensionEl, playSuspension, Date.now(), 'schedule')
      // A *changed* suspension moves the hedge on every row, which is the board's job.
      if (changed) render()

      if (!mixerEl) return
      if (cancelledCompetitions.includes(SOCIAL_MIXER_COMPETITION)) {
        mixerEl.hidden = true
        // A cancelled field is not a field to filter by either, so the chip goes with the band — and the
        // board is re-rendered, because the first render already offered it (see `mixerTakesPlace`). Guarded
        // now that this read repeats: without it every poll would re-render a page nothing changed on.
        if (mixerTakesPlace) {
          mixerTakesPlace = false
          render()
        }
        return
      }
      const when = mixerEl.querySelector<HTMLElement>('[data-mixer-when]')
      // No courts on the wire leaves the built line standing — fail-open, as above.
      if (when && socialMixerCourts?.length)
        when.textContent = socialMixerWhen(socialMixerBlockOn(socialMixerPlacement, socialMixerCourts))
      // The operator may have moved the block to the other day, so the band follows it there — and its
      // fallback heading names the day it followed.
      mixerDay = socialMixerPlacement.day
      const dayHead = mixerHomeEl?.querySelector('[data-mixer-day]')
      if (dayHead) dayHead.textContent = dayLabel(VIEW_COPY.days, mixerDay)
      placeMixerBand()
    } catch {
      // Leave the appointment as built — see above.
    }
  }

  load()
  start()
  void applyPhaseState()
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      load()
      // Coming back to the tab re-reads the phase too: a pocketed phone can miss an hour of polls, and
      // „Spielbetrieb unterbrochen" is exactly the thing that must not be an hour stale on the first look.
      void applyPhaseState()
      start()
    } else {
      stop()
    }
  })
</script>
