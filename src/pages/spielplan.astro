---
import Layout from '@/layouts/default.astro'
import { socialMixerWhen } from '@/data/tournament'
import tvLogo from '@/assets/logo.svg'
import tsvLogo from '@/assets/tsv-winsen.png'
import { resolveSocialMixerBlock, SOCIAL_MIXER_DEFAULT_PLACEMENT } from '../../shared'

// The appointment as built: the block at its planned placement. The head-count only sizes the *courts*,
// which this page does not name, so any confirmed count resolves the same line here (ADR-0064).
const defaultMixerBlock = resolveSocialMixerBlock({ ...SOCIAL_MIXER_DEFAULT_PLACEMENT, confirmed: 0 })!

// The public event-wide schedule + live board (ADR-0005, ADR-0032, ADR-0069, #91, #308): one page for the
// whole weekend that always shows the current truth, never the stale plan. It leads with a „Jetzt auf dem
// Platz" courts board — the 6 courts, each showing what is live on it right now (or „frei") — over a
// schedule grouped **day → court** that reflects status (geplant/läuft/beendet) and shows results for
// finished matches, and can be filtered by competition.
//
// The grouping is fixed, and the old „Nach Tag" / „Nach Platz" toggle stays gone (ADR-0071): the court is
// the column a player reads down to find their own afternoon, and „what is on right now" is the courts
// board's question anyway. Each court's first match carries a plain time („10:00"); everything that follows
// on that court carries „ca. 14:00", because a reservation is 90 minutes on average, not by rule.
//
// A match's court is the **actual** live court once running (the feed already falls back to the planned
// court before it starts), so a spectator is never sent to the wrong court. Built with the public site's
// inline-`<script>` + polling pattern (ADR-0008); every projection decision lives in shared/match-view.
---

<Layout title="Spielplan & Live — Winsener Meisterschaften 2026" chrome="legal">
  <div data-sheet class="mx-auto max-w-[900px] px-5 pt-12 pb-20 text-navy md:px-10 md:pt-16 md:pb-[120px]">
    <h1 class="mt-0 mb-3 text-[clamp(36px,6vw,56px)] font-black tracking-[-0.04em] uppercase">Spielplan &amp; Live</h1>
    <p class="mb-10 max-w-[60ch] text-sm leading-[1.6] opacity-70">
      Oben steht, was gerade auf den sechs Plätzen läuft. Darunter der Spielplan, Tag für Tag und Platz für Platz — von
      oben nach unten die Reihenfolge auf diesem Platz. Das erste Match auf einem Platz hat eine{' '}
      <strong>feste Zeit</strong> — davor liegt nichts, was es verschieben könnte. Alle weiteren stehen mit{' '}
      <strong>„ca."</strong>: sie fangen an, wenn das Match davor auf diesem Platz fertig ist, und 90 Minuten sind ein
      Erfahrungswert, keine Regel. Früher fängt also nichts an, später schon. Was wirklich passiert, steht im Status:
      läuft oder beendet mit Ergebnis.
    </p>

    <!-- The Social mixer's reserved court-time (ADR-0064, ADR-0063). It sits **outside** `[data-board]` on
         purpose: it is neither the forward plan the publish gate hides (ADR-0041) nor live truth — it is an
         appointment, and its participants must be able to read it whether or not the championship schedule
         is finished. Built statically at the block's **default** placement, so the page is right without JS
         and right for the placement the event was planned around; the operator may move the block
         (ADR-0064), so the one runtime read below patches this line — together with the cancellation
         (ADR-0062), off the single `/api/phase` signal both already ride (ADR-0048). Still no polling:
         an appointment does not change between polls, so it is read once on load.
         Deliberately **without court numbers**: the courts follow the confirmed head-count, and the one who
         needs them is told on arrival. Both runtime signals are fail-open — the built line stays put on a
         failed read, unlike the match feed's fail-closed reveal gate (ADR-0036), because the failure modes
         are not symmetric: withholding an appointment from its participants on a network blip is worse than
         briefly showing a stale time. -->
    <section data-mixer class="mixer">
      <h2 class="board-heading">Damen Doppel</h2>
      <p class="mixer-when" data-mixer-when>{socialMixerWhen(defaultMixerBlock)}</p>
      <p class="mixer-note">
        Geselliger Doppel-Spieltag mit wechselnden Partnerinnen — kein Turnierbaum, kein Ergebnis. Die Einteilung macht
        die Spielleiterin vor Ort; komm einfach zur angegebenen Zeit an die Plätze.
      </p>
    </section>

    <!-- Starts in the loading state so the board never paints a misleading empty „keine Spiele" grid before
         the first poll resolves — and if the inline script fails to load at all, this benign „lädt…" holding
         message stays put instead of a fake-empty board during a live event. The first successful render (or
         a failed poll) clears it. -->
    <!-- The two club crests the match row flies (#309), handed to the controller through the dataset: Astro
      fingerprints the bundled assets, so their URLs are the page's to know and never the render module's —
      the same wiring the participant list uses. -->
    <div data-board class="is-loading" data-logo-tv={tvLogo.src} data-logo-tsv={tsvLogo.src}>
      <p class="board-loading">Spielplan wird geladen …</p>
      <!-- The publish gate (ADR-0041): until the operator publishes and nothing is live yet, the planned
           schedule stays private and only this notice shows. A running/done match is live truth and is
           served + rendered even while unpublished, so the notice yields to it the moment any match arrives. -->
      <p class="board-unpublished">
        Der Spielplan ist noch nicht veröffentlicht. Sobald die Auslosung abgeschlossen ist, erscheinen hier alle
        Ansetzungen mit Platz und ungefährer Zeit — und am Wochenende, was gerade läuft.
      </p>
      <p class="board-error">Der Spielplan lässt sich gerade nicht laden. Bitte später erneut versuchen.</p>

      <section class="board-courts" aria-label="Jetzt auf dem Platz">
        <h2 class="board-heading">Jetzt auf dem Platz</h2>
        <div class="courts" data-courts></div>
      </section>

      <section class="board-schedule" aria-label="Spielplan">
        <div class="board-controls" data-controls>
          <div class="board-filter" data-filter aria-label="Konkurrenz filtern" role="group"></div>
        </div>

        <p class="board-empty">
          Noch keine Spiele geplant. Sobald die Auslosung läuft, erscheinen hier die Ansetzungen.
        </p>
        <div data-sections></div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  /* ── State visibility ─────────────────────────────────────────────────────────────────────────── */
  /* The initial loading state (before the first poll, or if the script never runs): hide the whole board
     and every notice, show only „lädt…". Cleared by the first successful render or a failed poll. */
  .board-loading {
    display: none;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  [data-board].is-loading .board-loading {
    display: block;
  }
  [data-board].is-loading .board-courts,
  [data-board].is-loading .board-schedule,
  [data-board].is-loading .board-unpublished,
  [data-board].is-loading .board-error {
    display: none;
  }

  .board-error,
  .board-unpublished {
    display: none;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  /* Error wins over everything: hide the whole board (and the „noch nicht veröffentlicht" notice, which a
     prior successful poll may have left showing — render() only runs on success, so a failed poll adds
     `is-error` without clearing `not-published`), show only the error. */
  [data-board].is-error .board-courts,
  [data-board].is-error .board-schedule,
  [data-board].is-error .board-unpublished {
    display: none;
  }
  [data-board].is-error .board-error {
    display: block;
    font-size: 14px;
  }
  /* Unpublished with nothing live: hide the board, show the „noch nicht veröffentlicht" notice. */
  [data-board].not-published .board-courts,
  [data-board].not-published .board-schedule {
    display: none;
  }
  [data-board].not-published .board-unpublished {
    display: block;
  }
  /* The competition filter only means anything once there are matches. */
  [data-board]:not(.has-matches) .board-controls {
    display: none;
  }
  /* The empty note shows only when published-but-empty (no matches, but past the publish gate). */
  .board-empty {
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  [data-board].has-matches .board-empty,
  [data-board].not-published .board-empty,
  [data-board].is-error .board-empty {
    display: none;
  }

  /* The Social mixer's fixed appointment (ADR-0063): a calm card above the board, deliberately not styled
     as a match row — it is an appointment, not an ansetzung. Outside [data-board], so no board state
     (loading, error, unpublished) touches it. */
  .mixer {
    margin: 0 0 32px;
    padding: 18px 20px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-navy) 3%, transparent);
  }
  .mixer[hidden] {
    display: none;
  }
  .mixer-when {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .mixer-note {
    margin: 0;
    max-width: 60ch;
    font-size: 14px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }

  .board-heading {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  /* ── Courts board („Jetzt auf dem Platz") ─────────────────────────────────────────────────────── */
  .board-courts {
    margin-bottom: 44px;
  }
  .courts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }
  .court {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 104px;
    padding: 12px 14px;
    border: 1px solid color-mix(in srgb, var(--color-navy) 14%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-navy) 2%, transparent);
    transition: opacity 0.15s ease;
  }
  /* A court running a match gets a live accent; an empty one stays quiet. */
  .court--live {
    border-color: color-mix(in srgb, var(--color-live) 35%, transparent);
    background: color-mix(in srgb, var(--color-live) 6%, transparent);
  }
  /* When a competition filter is active, courts that are not the focused field fade back — never blanked
     to „frei" (that would lie about a physically busy court), just de-emphasised (ADR-0032: stay truthful). */
  .court--dim {
    opacity: 0.4;
  }
  .court__no {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  .court--live .court__no {
    color: var(--color-live);
  }
  .court__free {
    margin: auto 0;
    font-size: 15px;
    font-weight: 700;
    color: color-mix(in srgb, var(--color-navy) 35%, transparent);
  }
  .court__players {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .court__meta {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }

  /* ── Controls (competition filter + grouping toggle) ──────────────────────────────────────────── */
  .board-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 26px;
  }
  .board-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .board-chip {
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-navy) 65%, transparent);
    background: color-mix(in srgb, var(--color-navy) 6%, transparent);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
  }
  .board-chip.is-active {
    color: var(--color-text-inverted);
    background: var(--color-navy);
  }
  /* ── Schedule sections (day → court) ──────────────────────────────────────────────────────────── */
  .sched-day {
    margin-top: 44px;
  }
  .sched-day:first-child {
    margin-top: 0;
  }
  .sched-day__head {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
    border-bottom: 2px solid var(--color-navy);
    padding-bottom: 6px;
  }
  .sched-court {
    margin-top: 26px;
  }
  /* The court is the unit a spectator reads down — top to bottom is the order of play on that court, and
     the frame in which a „ca." earns its hedge. Its heading is quieter than the day's: the day is the
     section, the court is the column inside it. */
  .sched-court__head {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  /* Time · contestants · status. The time column now holds at most „ca. 14:00" on one line (ADR-0071), so it
     is narrower than the two-line floor needed — the names get the width back. */
  .sched-match {
    display: grid;
    grid-template-columns: 68px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 4px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-navy) 12%, transparent);
  }
  .sched-match__time {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    color: var(--color-blue);
  }
  /* A follow-on time is a weaker claim than a court's first match, and it reads that way. The „ca." carries
     that in two characters; this carries it a second time, for a phone in bright sunlight. */
  .sched-match__time--follows {
    font-weight: 700;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
  }
  /* The two contestant lines share **one** grid — identity · sets · outcome — so the sets line up down a
     column between them, which is the reference tournaments' single most useful habit. A grid per line
     would not do it: „· Aufg." on the winner's line would widen only that line and shove its sets left,
     breaking the column on exactly the case the outcome token introduces. The lines dissolve into this
     grid (`display: contents`) and keep their element only as the hook the winner/tbd rules select on. */
  .sched-match__players {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: 10px;
    min-width: 0;
  }
  .sched-match__players .sched-match__player {
    display: contents;
  }
  .sched-match__players .sched-match__meta {
    grid-column: 1 / -1;
  }
  /* The courts board reuses the contestant line outside that grid, where it stays a plain flex row. */
  .sched-match__player {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  /* Crest · name · seed · check, in the order a tennis reader expects them (#309). */
  .sched-match__ident {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  /* The club crest, in place of the country flag the references fly — we have no nations, but we do have
     clubs, and that is what this audience reads. Same white disc as the participant list's avatar. */
  .sched-match__crest {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-surface);
    overflow: hidden;
  }
  .sched-match__crest img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sched-match__name {
    min-width: 0;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The seed rides small and muted behind the name — the references keep exactly this slot for it, so the
     number never competes with the person. */
  .sched-match__seed {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }
  /* The winner's second mark. Bold alone loses on a phone in the sun, so the check carries the result
     redundantly — a tick, never a tinted row. */
  .sched-match__check {
    flex-shrink: 0;
    font-size: 12px;
    line-height: 1;
    color: var(--color-blue);
  }
  .sched-match__player--tbd .sched-match__name {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }
  /* The winner of a finished match reads bold — the primary result signal on the board. */
  .sched-match__player--winner .sched-match__name {
    font-weight: 800;
  }
  /* Right-aligned within its column, so the sets read down a column between the two lines. */
  .sched-match__games {
    flex-shrink: 0;
    justify-self: end;
    text-align: right;
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
  }
  .sched-match__player--winner .sched-match__games {
    color: var(--color-navy);
  }
  /* „· Aufg." / „w.o." — the outcome where the score is, terse and quiet beside the sets it qualifies. Its
     own column, so it never widens the sets' one and never shifts them out of line. */
  .sched-match__outcome {
    flex-shrink: 0;
    justify-self: end;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  .sched-match__meta {
    margin-top: 3px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
  }
  .sched-status {
    justify-self: end;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
  }
  .sched-status--planned {
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
    background: color-mix(in srgb, var(--color-navy) 7%, transparent);
  }
  .sched-status--running {
    color: var(--color-live);
    background: color-mix(in srgb, var(--color-live) 12%, transparent);
  }
  .sched-status--done {
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
    background: color-mix(in srgb, var(--color-navy) 5%, transparent);
  }

  /* ── Print ────────────────────────────────────────────────────────────────────────────────────── */
  /* The paper copy at the results desk (#310). A stylesheet, not a PDF generator: the browser already
     renders this page, and a generator would be new infrastructure for one button. What goes on paper is
     the plan — day sections, court columns, time, contestants, score — and nothing that only works on a
     screen. Everything below is the same DOM as the screen, so a change to the row anatomy lands here too.

     Deliberately dropped: the site chrome (a nav bar is not a sheet), the competition filter (an
     interaction control prints as a lie — the chips look pressable and nothing happens), and the
     „Jetzt auf dem Platz" board, which is true for the minute it was printed and misleading from then on.
     The Social mixer's appointment stays: it is a fixed date, and paper is exactly where a date belongs. */
  @media print {
    @page {
      margin: 14mm;
    }

    /* No chrome and no controls on the sheet. */
    .skip-link,
    header,
    footer,
    .board-controls {
      display: none !important;
    }
    /* The live board is a snapshot; on paper it is stale before the page leaves the printer. */
    .board-courts {
      display: none !important;
    }

    /* Ink is expensive and the page tints are decoration: black text on white paper, the whole way down.
       No `print-color-adjust` anywhere — the tinted status pills and court cards are meant to drop out. */
    [data-sheet] {
      max-width: none;
      padding: 0;
      color: #000;
    }
    [data-sheet] h1 {
      font-size: 24pt;
      margin-bottom: 6pt;
    }
    [data-sheet] > p {
      max-width: none;
      opacity: 1;
      font-size: 9pt;
      margin-bottom: 12pt;
    }
    .mixer {
      margin-bottom: 12pt;
      padding: 8pt 10pt;
      background: none;
      border-color: #000;
    }
    .mixer-when {
      font-size: 11pt;
    }
    .mixer-note {
      font-size: 8.5pt;
      color: #000;
    }

    /* A day starts a fresh sheet from the second one on, and a heading never prints alone at a page foot. */
    .sched-day {
      margin-top: 0;
      break-before: page;
    }
    .sched-day:first-child {
      break-before: auto;
    }
    .sched-day__head,
    .sched-court__head {
      break-after: avoid;
      color: #000;
    }
    .sched-day__head {
      font-size: 11pt;
      border-bottom-color: #000;
    }
    .sched-court {
      margin-top: 14pt;
      break-inside: avoid;
    }
    .sched-court__head {
      font-size: 10pt;
    }

    /* No row is ever cut in half by a page break, and none of its parts is cut off by the box either:
       a name that no longer fits wraps onto a second line rather than ending in an ellipsis. */
    .sched-match {
      break-inside: avoid;
      padding: 5pt 0;
      border-bottom-color: rgba(0, 0, 0, 0.35);
    }
    .sched-match__time,
    .sched-match__time--follows {
      font-size: 9pt;
      font-weight: 700;
      color: #000;
    }
    .sched-match__name {
      font-size: 10pt;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .sched-match__seed,
    .sched-match__games,
    .sched-match__outcome,
    .sched-match__meta {
      color: #000;
    }
    .sched-match__player--tbd .sched-match__name {
      color: #000;
    }
    .sched-match__check {
      color: #000;
    }
    /* The status keeps its word and loses its pill — the tint is what carried it on screen. */
    .sched-status {
      padding: 0;
      background: none !important;
      color: #000 !important;
    }
  }
</style>

<script>
  import { hc } from 'hono/client'
  import { resolveSocialMixerBlock, scheduleView } from '../../shared'
  import { renderCourts, renderFilter, renderSchedule } from '../components/schedule-board.render'
  import { competitions, socialMixerWhen, tournament } from '../data/tournament'
  import type { AppType } from '../../worker/app'
  import type { ScheduleResponse } from '../../shared'

  // The public schedule board's controller: fetch → state → poll → project → render. Every decision lives
  // in `scheduleView` (shared/match-view) and all the DOM building in ../components/schedule-board.render;
  // this script only keeps the feed and the one view control, and decides when to hand them over.
  const client = hc<AppType>(location.origin)

  // The two pieces of client copy the projection needs as data: the event's dates and the competition
  // labels. They stay here, with the rest of the event's copy — `shared/` must not reach into src/data, so
  // the page hands them over rather than the module importing them.
  const VIEW_COPY = {
    days: [tournament.saturday, tournament.sunday],
    competitions: competitions.map(c => ({ slug: c.slug, label: c.label }))
  }

  // The live board polls ~15 s (ADR-0008): a started match, a moved court, or a completed result appears
  // within the interval, light enough for a phone on event Wi-Fi.
  const POLL_MS = 15000

  const root = document.querySelector<HTMLElement>('[data-board]')
  const courtsEl = root?.querySelector<HTMLElement>('[data-courts]') ?? null
  const filterEl = root?.querySelector<HTMLElement>('[data-filter]') ?? null
  const sectionsEl = root?.querySelector<HTMLElement>('[data-sections]') ?? null

  // The crest URLs off the dataset (see the markup above). Empty strings are unreachable in practice; a
  // missing crest would render a broken image, never break the board.
  const LOGOS = { tv: root?.dataset.logoTv ?? '', tsv: root?.dataset.logoTsv ?? '' }

  // The competition filter lives in the URL (#310): a reload on the grounds keeps the field the spectator
  // picked, and „hier ist der Spielplan der Herren" becomes a link somebody can send. English key and
  // value — this is a wire value and the slugs already read `mens`/`womens`; the route slug stays German,
  // which ADR-0028 permits exactly here. An unknown or cancelled field needs no handling of its own: the
  // view drops a selection it does not offer, so the page degrades to „Alle" and says nothing about it.
  const FILTER_PARAM = 'competition'

  // Only a click writes the address back. The view's verdict is about the feed of *this* poll — an
  // unpublished or freshly reset plan carries no fields at all, so every selection degrades to „Alle" —
  // and letting that rewrite the URL would quietly strip a link somebody shared before the plan came back.
  const writeFilterToUrl = (slug: string | null) => {
    const url = new URL(location.href)
    if (slug === null) url.searchParams.delete(FILTER_PARAM)
    else url.searchParams.set(FILTER_PARAM, slug)
    history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`)
  }

  // The last-served feed plus the one view control. The filter re-renders from the cached feed (no
  // refetch), so changing it is instant; the poll only replaces `feed` and re-renders.
  let feed: ScheduleResponse = { published: false, matches: [] }
  // The competition slug, or null = „Alle" — seeded from the URL, so the very first render is already the
  // view the link promised.
  let selectedCompetition: string | null = new URL(location.href).searchParams.get(FILTER_PARAM)

  const render = () => {
    if (!root) return
    // The first render replaces the initial „lädt…" holding state with the real one.
    root.classList.remove('is-loading')
    const { published, matches } = feed
    root.classList.toggle('not-published', !published && matches.length === 0)
    root.classList.toggle('has-matches', matches.length > 0)

    const {
      competitions: options,
      selected,
      courts,
      days
    } = scheduleView(feed, {
      ...VIEW_COPY,
      competition: selectedCompetition
    })
    // The view decides whether the stored selection still applies (a field the feed stopped carrying, or a
    // page with nothing left to choose between), so the controller adopts its verdict rather than holding
    // on to a selection the page no longer offers.
    selectedCompetition = selected

    renderFilter(filterEl, options, selected, slug => {
      selectedCompetition = slug
      writeFilterToUrl(slug)
      render()
    })
    renderCourts(courtsEl, courts, LOGOS)
    renderSchedule(sectionsEl, days, LOGOS)
  }

  let lastJson = ''
  const load = async () => {
    if (!root) return
    try {
      const res = await client.api.schedule.$get()
      if (!res.ok) throw new Error('bad status')
      const body: ScheduleResponse = await res.json()
      root.classList.remove('is-error')
      // Skip the rebuild when nothing changed since the last poll — the publish flag is part of the
      // signature so a publish/reset toggles the page on the next poll. The filter bypasses this (it calls
      // render() directly), so changing it is always instant.
      const sig = JSON.stringify({ published: body.published, matches: body.matches })
      if (sig === lastJson) return
      lastJson = sig
      feed = { published: body.published, matches: body.matches }
      render()
    } catch {
      // A failed poll clears the loading state too, so a first-poll failure shows the error, not „lädt…".
      root.classList.remove('is-loading')
      root.classList.add('is-error')
    }
  }

  let timer: ReturnType<typeof setInterval> | undefined
  const start = () => {
    if (timer === undefined) timer = setInterval(load, POLL_MS)
  }
  const stop = () => {
    if (timer !== undefined) {
      clearInterval(timer)
      timer = undefined
    }
  }

  // The Social mixer's appointment is built statically, but two facts about it are the server's: whether
  // the competition still takes place (ADR-0062) and where the operator has put the block (ADR-0064). Both
  // ride the one `/api/phase` read, done once on load — an appointment does not need polling — and both
  // fail open: a failed read leaves the built line standing rather than withholding it (see the markup).
  const applyMixerState = async () => {
    const mixer = document.querySelector<HTMLElement>('[data-mixer]')
    if (!mixer) return
    try {
      const res = await client.api.phase.$get()
      if (!res.ok) return
      const { cancelledCompetitions, socialMixerPlacement } = await res.json()
      if (cancelledCompetitions.includes('womens-social')) {
        mixer.hidden = true
        return
      }
      const when = mixer.querySelector<HTMLElement>('[data-mixer-when]')
      // Any confirmed count resolves the same sentence — only the courts follow the head-count, and this
      // line does not name them.
      const block = resolveSocialMixerBlock({ ...socialMixerPlacement, confirmed: 0 })
      if (when && block) when.textContent = socialMixerWhen(block)
    } catch {
      // Leave the appointment as built — see above.
    }
  }

  load()
  start()
  void applyMixerState()
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      load()
      start()
    } else {
      stop()
    }
  })
</script>
