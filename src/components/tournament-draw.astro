---
import { competitions } from '@/data/tournament'
import { drawableCompetitions } from './tournament-draw.render'

// Live draw per competition: the seeded players fill in from the participant feed,
// every other slot is a "?" until the draw. Challenger has a draw too — unlike
// the participant list it is seeded here, since a draw without seeds makes no sense.
// Which fields appear (and in which order) is `drawableCompetitions`, so the rule is
// stated once and testable; cancelled fields lose their tab client-side (ADR-0062).
const drawCompetitions = drawableCompetitions(competitions)
---

<div class="dm" data-draw>
  <div class="dm-tabs" role="tablist" aria-label="Konkurrenz wählen" data-tabs>
    {
      drawCompetitions.map((c, i) => (
        <button
          type="button"
          class="dm-tab"
          role="tab"
          id={`dm-tab-${c.slug}`}
          aria-controls={`dm-panel-${c.slug}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tab={c.slug}
        >
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="dm-panels" data-panels>
    {
      drawCompetitions.map((c, i) => (
        <div
          class="dm-panel"
          role="tabpanel"
          id={`dm-panel-${c.slug}`}
          aria-labelledby={`dm-tab-${c.slug}`}
          data-panel={c.slug}
          hidden={i !== 0}
        >
          {/* The two controls, nested rather than stacked as equals (#312, ADR-0004): the bracket is the
              outer choice — the consolation is a tournament of its own — and the round is a position inside
              it. The round control is the phone's way through the bracket; the wide tree shows every round
              at once, so the stylesheet hides it there. */}
          <div class="dm-segments" role="tablist" aria-label="Hauptrunde oder Nebenrunde wählen" data-segments hidden />
          <div class="dm-rounds" role="tablist" aria-label="Runde wählen" data-rounds hidden />
          <div class="dm-scroll" data-scroll>
            <div class="dm-bracket" data-bracket />
          </div>
        </div>
      ))
    }
  </div>

  <p class="dm-legend" data-legend>
    {
      /* Starts hidden: the seed legend advertises LK-based seeding, so it stays off until the wire confirms
        the selected field is *not* redacted (ADR-0048) — a protected field must never flash it pre-load. */
    }
    <span class="dm-legend__item" data-legend-seed hidden>
      <span class="dm-legend__chip dm-legend__chip--seed">1</span> nach Leistungsklasse gesetzt
    </span>
    <span class="dm-legend__item">
      <span class="dm-legend__chip dm-legend__chip--tbd">?</span> wird bei der Auslosung gelost
    </span>
  </p>

  <p class="dm-error">Der Draw lässt sich gerade nicht laden. Bitte später erneut versuchen.</p>
</div>

<style is:global>
  .dm {
    --dm-line: color-mix(in srgb, var(--color-navy) 22%, transparent);
    --dm-gap: 34px;
    /* One column's width. Wider since the cell carries its score (ADR-0070): seed · name · LK · sets still
       has to fit on one line at 13px, and the name's ellipsis is the last resort, not the first. Four rounds
       — our deepest field — still land inside a laptop's width without horizontal scrolling. */
    --dm-col: 258px;
  }

  /* — Tabs — */
  .dm-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .dm-tab {
    font-family: inherit;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--color-navy) 25%, transparent);
    padding: 9px 16px;
    cursor: pointer;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }
  .dm-tab:hover {
    border-color: var(--color-navy);
  }
  .dm-tab[aria-selected='true'] {
    background: var(--color-navy);
    color: var(--color-text-inverted);
    border-color: var(--color-navy);
  }
  .dm-tab:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }

  /* — Panels / scroll — */
  .dm-panel[hidden] {
    display: none;
  }
  .dm-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
  }
  /* The render target (vertical): the round-column tree and — at phone width instead of it — the chosen
     round's list (#312). Left-anchored so a preview or reveal tree starts at the first column. */
  .dm-bracket {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
  }
  /* The preview's and the reveal's tree: round columns laid out left→right at their natural width, the widest
     thing in the panel, so the horizontal scroll rides it. The live bracket does not scroll — see below. */
  .dm-tree {
    display: flex;
    align-items: stretch;
    gap: var(--dm-gap);
    min-width: min-content;
  }

  /* — The live bracket's tree: a grid, so the whole draw fits the width (#312) —
     The columns are tracks capped at `--dm-col` but free to shrink (`minmax(0, …)`), so four rounds — our
     deepest field — land inside a laptop without horizontal scrolling; the name's ellipsis absorbs the last
     few pixels, which is what it is for. `justify-content: start` keeps a shallow bracket left-anchored
     instead of stretching two columns across the page.

     The second reason for a grid is the playoff: it takes a row of its own under the final column, and a grid
     row cannot steal height from the tree row. As a flex item it would have shortened the final's column and
     pulled the final off the mid-point its two feeders' elbows aim at. */
  .dm-tree--live {
    display: grid;
    grid-template-columns: repeat(var(--dm-cols, 1), minmax(0, var(--dm-col)));
    justify-content: start;
    align-items: stretch;
    column-gap: var(--dm-gap);
    row-gap: 26px;
    width: 100%;
    min-width: 0;
  }
  /* A track owns the column's width now, so the fixed width comes off — otherwise it would push the grid
     back out to the scrolling width the tree used to have. */
  .dm-tree--live .dm-round {
    width: auto;
    min-width: 0;
  }

  /* — Bracket control („Hauptrunde" / „Nebenrunde") — a lighter, secondary tab row inside a live panel, shown
     only when a consolation bracket exists (ADR-0046). The „Spiel um Platz 3" rides under the main bracket’s
     final, so there is no tab for it. This is the *outer* of the two controls (#312): pills, so the joined
     round control below can never read as a second row of the same rank. */
  .dm-segments {
    display: flex;
    gap: 6px;
    margin-bottom: 22px;
  }
  .dm-segments[hidden] {
    display: none;
  }
  .dm-seg {
    font-family: inherit;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--color-navy) 18%, transparent);
    border-radius: 999px;
    padding: 6px 15px;
    cursor: pointer;
    transition:
      background 0.18s,
      color 0.18s,
      border-color 0.18s;
  }
  .dm-seg:hover {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }
  .dm-seg[aria-selected='true'] {
    background: var(--color-navy);
    color: var(--color-text-inverted);
    border-color: var(--color-navy);
  }
  .dm-seg:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }

  /* — Round control (a bracket's rounds) — the phone's way through the bracket (#312), and
     the *inner* choice: a joined, full-width segmented control, so it never reads as a second row of the
     pills above it. Its labels are the view's own round names (#307), so nothing here knows any German.
     Hidden by default because the wide tree shows every round at once and has nothing to navigate; the
     breakpoint at the end of this stylesheet brings it in. */
  .dm-rounds {
    display: none;
    margin-bottom: 20px;
    border: 1.5px solid color-mix(in srgb, var(--color-navy) 22%, transparent);
  }
  /* Mixed case and no tracking, unlike every other control on this surface — „Achtelfinale" is twelve
     characters and four of them have to share a phone's width, and uppercase with letter-spacing truncates it
     to „ACHTELFI…". It also keeps the inner control visibly a rank below the pills above it. */
  .dm-roundtab {
    flex: 1 1 0;
    min-width: 0;
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 700;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
    background: transparent;
    border: 0;
    padding: 10px 4px;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background 0.18s,
      color 0.18s;
  }
  .dm-roundtab + .dm-roundtab {
    border-left: 1.5px solid color-mix(in srgb, var(--color-navy) 22%, transparent);
  }
  .dm-roundtab[aria-selected='true'] {
    background: var(--color-navy);
    color: var(--color-text-inverted);
  }
  .dm-roundtab:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: -2px;
  }

  /* — The round list: one round read top to bottom, at phone width, in the same cell shape the tree uses
     (#312, #309). Hidden on a wide screen, where the tree is the layout. */
  .dm-list {
    display: none;
    width: 100%;
    flex-direction: column;
    gap: 18px;
  }
  /* A list row sizes to its content — the tree's `flex: 1 1 0` exists to divide a column's height, and there
     is no column here. */
  .dm-list .dm-match {
    flex: 0 0 auto;
  }

  /* — The „Spiel um Platz 3" (ADR-0046, #312): a cell like any other, under the final it shares a round with
     — in the tree a second grid row beneath the final's column, in the round list the last row of the final
     round. Its own label, because the round column above it names the final and not this. */
  .dm-tree--live .dm-match--playoff {
    grid-row: 2;
    grid-column: -2 / -1;
    padding-top: 18px;
    border-top: 1px dashed color-mix(in srgb, var(--color-navy) 20%, transparent);
  }
  /* It grows no elbow stubs of its own accord: both connector rules are scoped to a `.dm-round`, and the
     playoff is a sibling of the columns rather than a cell inside one — which is right, because nothing in
     the tree feeds it. It is fed by the semifinals' losers. */
  .dm-match__label {
    display: flex;
    align-items: center;
    margin-bottom: 2px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  /* The pre-draw „needs ≥4" notice — shown instead of a bracket while a field is below the draw floor
     (ADR-0034). Left-anchored like the bracket's first column (the field starts here, hasn't grown
     right yet); the four pips are the signature — the draw floor filling toward four. */
  .dm-needfour {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 460px;
    padding: 44px 4px;
    color: var(--color-navy);
  }
  .dm-needfour__eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-clay);
  }
  .dm-needfour__pips {
    display: flex;
    gap: 14px;
  }
  .dm-pip {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--color-navy) 30%, transparent);
  }
  .dm-pip--filled {
    border: none;
    background: var(--color-navy);
  }
  .dm-needfour__caption {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-navy) 62%, transparent);
  }

  /* — A round column — */
  .dm-round {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: var(--dm-col);
  }
  .dm-round__label {
    flex: 0 0 auto;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-navy);
    border-bottom: 2px solid var(--color-navy);
  }
  .dm-round__count {
    margin-left: auto;
    font-weight: 700;
    color: color-mix(in srgb, var(--color-navy) 45%, transparent);
    font-variant-numeric: tabular-nums;
  }
  .dm-round__matches {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  /* — A match (two slots) — */
  .dm-match {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    position: relative;
  }

  /* The caption above a matchup (#159): court + day, then the floor („ab 14:00" / „im Anschluss · nicht vor
     ca. 14:00", ADR-0069) and — for a match on court right now — the „läuft" badge. Small, muted and tabular
     so the times align down a column.

     In the live tree it is emitted even when empty, because it is the **gated** half of the cell (ADR-0070):
     it disappears with an unpublished or reset plan while the score stays, and an emptied header must not
     change a column's heights or the elbow connectors would fall out of alignment. Spacing reads it as the
     pairing's header — more air above than below, so it binds to its own pair while the two slots stay one
     tight unit (the `.dm-match` gap). */
  .dm-when {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 15px;
    margin-top: 14px;
    margin-bottom: 3px;
    padding-left: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }
  /* The floor reads quieter as a follow-on than as an anchored start: „ab 14:00" is a time the court holds,
     „im Anschluss …" is a bound on one that can only move later. It is also the longest string in the
     header, so it takes the ellipsis rather than pushing the court out. */
  .dm-when__time {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dm-when__time--follows {
    font-weight: 600;
    color: color-mix(in srgb, var(--color-navy) 42%, transparent);
  }
  /* „läuft" — the one status the bracket marks, in the same live tint the schedule board uses (#306). It is
     what tells a match on court right now from one not yet started while no set has been saved. */
  .dm-live {
    flex-shrink: 0;
    margin-left: auto;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-live);
    background: color-mix(in srgb, var(--color-live) 12%, transparent);
    border-radius: 999px;
  }

  /* Elbow connectors: each non-final match draws a horizontal stub at each slot-pair
     centre plus half a vertical to the pair mid-point; the next round's match taps in
     from the left. All percentage-based, so it scales to any round height.

     „Has a round column after it" rather than „is not the last child" (#312): the playoff is a sibling of the
     columns in the live grid, so the positional test would call the final column non-final and draw a stub out
     of the champion's match into empty space. The test is on the tree's own structure, which is what the
     connectors describe. */
  .dm-round:has(~ .dm-round) .dm-match::after {
    content: '';
    position: absolute;
    left: 100%;
    width: calc(var(--dm-gap) / 2);
    border-right: 2px solid var(--dm-line);
    border-top: 0;
    border-bottom: 0;
  }
  .dm-round:has(~ .dm-round) .dm-match:nth-child(odd)::after {
    top: 50%;
    height: 50%;
    border-top: 2px solid var(--dm-line);
  }
  .dm-round:has(~ .dm-round) .dm-match:nth-child(even)::after {
    bottom: 50%;
    height: 50%;
    border-bottom: 2px solid var(--dm-line);
  }
  /* incoming stub into every round after the first */
  .dm-round:not(:first-child) .dm-match::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: calc(var(--dm-gap) / 2);
    height: 2px;
    background: var(--dm-line);
  }

  /* — A slot — */
  .dm-slot {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 5px 9px 5px 6px;
    background: var(--color-surface);
    border: 1.5px solid color-mix(in srgb, var(--color-navy) 14%, transparent);
  }
  .dm-slot--seed {
    border-color: var(--color-navy);
  }
  .dm-slot--tbd {
    background: transparent;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-navy) 28%, transparent);
    justify-content: center;
  }
  /* A revealed bye line: the paired seed advances „ohne Spiel" (§31), so the line itself is empty. */
  .dm-slot--bye {
    background: color-mix(in srgb, var(--color-navy) 3%, transparent);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-navy) 18%, transparent);
    justify-content: center;
  }
  .dm-bye {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }

  /* A lot-group line of the pre-draw preview (§30.5b): the line is prescribed, which of Nr. 3/4 lands
     on it is not — so it carries both names, dashed like the other undecided lines but still inked,
     because the players on it are settled. */
  .dm-slot--lot {
    border-style: dashed;
    border-color: var(--color-navy);
  }
  .dm-lotno {
    flex-shrink: 0;
    height: 22px;
    padding: 0 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--color-navy);
    color: var(--color-navy);
    font-size: 12px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    border-radius: 11px;
  }
  .dm-lot {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }

  /* A not-yet-decided later-round line in the live bracket (ADR-0046): „Sieger M3" / „Verlierer M2" /
     „offen" (ADR-0035). Dashed + muted like the „?" line, but carrying the feeder label. */
  .dm-slot--feeder {
    background: transparent;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-navy) 24%, transparent);
  }
  .dm-feeder {
    flex: 1;
    min-width: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* A decided match (ADR-0046): the winner's line takes a navy accent bar and stays fully inked; the
     loser's fades back. Layered on top of the base player slot, so a seeded winner keeps its seed badge. */
  .dm-slot--winner {
    border-color: var(--color-navy);
    box-shadow: inset 3px 0 0 var(--color-navy);
  }
  .dm-slot--loser {
    opacity: 0.5;
  }

  .dm-seedno {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy);
    color: var(--color-text-inverted);
    font-size: 12px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    border-radius: 50%;
  }
  .dm-name {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dm-lk {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--color-blue);
  }
  .dm-lk--pending {
    color: color-mix(in srgb, var(--color-navy) 40%, transparent);
  }
  /* — A live cell's line: the score column beside the identity (ADR-0070) — */
  /* The sets, right-aligned and tabular so they line up between the two contestant lines and read down a
     column. Emitted even when empty, so a walkover's „w.o." can never slide into the sets' place. The
     winner's sets ink fully; the loser's line fades as a whole (`.dm-slot--loser`). */
  .dm-games {
    flex-shrink: 0;
    min-width: 34px;
    text-align: right;
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-navy) 60%, transparent);
  }
  .dm-slot--winner .dm-games {
    color: var(--color-navy);
  }
  /* „· Aufg." / „w.o." — the outcome where a reader looks for the score, terse and quiet beside the sets it
     qualifies, rather than spelled out at the far end of a meta line. */
  .dm-outcome {
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-navy) 55%, transparent);
  }
  /* The winner is marked twice — this check and the line's navy accent bar. The redundancy is the reference
     tournaments' convention and it is deliberate: on a phone in bright sunlight a weight difference alone
     does not survive. */
  .dm-check {
    flex-shrink: 0;
    font-size: 11px;
    line-height: 1;
    color: var(--color-blue);
  }
  /* A cell line packs more than a preview line does, so it gives the name every pixel the fixed pieces do
     not need — and tightens the gaps rather than letting the ellipsis start early. */
  .dm-slot--cell {
    gap: 6px;
  }
  .dm-slot--cell .dm-name {
    font-size: 12.5px;
  }

  .dm-q {
    font-size: 15px;
    font-weight: 800;
    color: color-mix(in srgb, var(--color-navy) 40%, transparent);
  }

  /* — Legend — */
  .dm-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }
  .dm-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  /* Hidden on a Challenger tab (no seed badge there) — explicit, as inline-flex would override [hidden]. */
  .dm-legend__item[hidden] {
    display: none;
  }
  .dm-legend__chip {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
    border-radius: 50%;
  }
  .dm-legend__chip--seed {
    background: var(--color-navy);
    color: var(--color-text-inverted);
  }
  .dm-legend__chip--tbd {
    border: 1.5px dashed color-mix(in srgb, var(--color-navy) 40%, transparent);
    color: color-mix(in srgb, var(--color-navy) 50%, transparent);
  }

  .dm.is-error .dm-panels,
  .dm.is-error .dm-legend {
    display: none;
  }
  .dm-error {
    display: none;
    font-size: 14px;
    color: color-mix(in srgb, var(--color-navy) 70%, transparent);
  }

  /* — The phone layout (#312) — Below two columns' worth of width the elbow tree stops being readable, so the
     live bracket becomes a round control plus one round as a list, and nothing is scrolled sideways. Both
     layouts are always in the DOM; this is the whole switch, which is why the controller owns no breakpoint.

     The pre-draw preview and the reveal show keep their tree here: they place round-1 lines and their later
     columns are „?" until the field is drawn, so there is no round to navigate to yet. */
  @media (max-width: 900px) {
    .dm-tree--live {
      display: none;
    }
    .dm-list {
      display: flex;
    }
    /* `:not([hidden])` rather than a second rule: the control is hidden outright during the preview and the
       reveal, and a bare `display: flex` here would out-specify that. */
    .dm-rounds:not([hidden]) {
      display: flex;
    }
  }
  .dm.is-error .dm-error {
    display: block;
  }

  /* — Print (#313) — The bracket's own anatomy on paper, the counterpart of /spielplan's sheet (#310) and,
     like it, a stylesheet rather than a PDF generator: the browser already renders this. What the *page*
     drops around the bracket is decided in index.astro; everything here is about the bracket itself.

     Two things have to be true on paper, and they are the same two the acceptance criteria name: **every
     round** is on the sheet, and **no cell is cut off**. Both need this block, because a sheet is narrow —
     an A4 page is inside the 900px phone breakpoint above, so without these rules paper would get the
     round list, i.e. exactly one round of the bracket, chosen by whoever last touched the control.

     Nothing pressable prints. A tab row, a pill or a segmented control on paper is a lie: it looks
     interactive and there is nothing behind it. But what a control *says* about the sheet is not a control:
     the printed tree is one field's one bracket, and „Damen · Nebenrunde" is the only thing on the page that
     says which — so the two selected buttons print as plain captions and their unselected siblings leave.
     The round control leaves outright: every round is on the sheet, so it names nothing. The legend stays —
     it explains the seed and „?" chips, which is a caption too. */
  @media print {
    /* Ink is expensive and the tints are decoration: black on white, and the lines dark enough to read as
       the tree's wiring rather than as a smudge. */
    .dm {
      /* A track's *maximum*, and the tracks shrink below it (`minmax(0, …)`), so the deepest field's four
         rounds land inside a portrait page without anything being cut off the right edge. */
      --dm-col: 168px;
      --dm-gap: 18px;
      --dm-line: #000;
      color: #000;
    }
    .dm-rounds,
    .dm-error {
      display: none !important;
    }
    /* The two selected buttons as the sheet's caption line — „Herren", „Nebenrunde" — inked, unboxed and
       side by side, so the paper says what it shows without looking pressable. Every other button leaves. */
    .dm-tabs,
    .dm-segments {
      display: block;
      margin-bottom: 10px;
    }
    .dm-tab,
    .dm-seg {
      display: none;
    }
    .dm-tab[aria-selected='true'],
    .dm-seg[aria-selected='true'] {
      display: inline;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      color: #000;
      font-size: 12px;
    }
    /* Hidden outright when the field has no consolation to choose between (ADR-0004) — a lone „Hauptrunde"
       on a field that has only one bracket says nothing the tree does not. */
    .dm-segments[hidden] {
      display: none;
    }
    /* The tree, at every paper width — see the note above on why this cannot be left to the breakpoint. */
    .dm-tree--live {
      display: grid !important;
    }
    .dm-list {
      display: none !important;
    }
    /* The sideways scroll is a screen affordance; on paper it would simply clip the last round away. */
    .dm-scroll {
      overflow: visible;
      padding-bottom: 0;
    }
    /* A name that no longer fits wraps onto a second line rather than ending in an ellipsis — the cell grows,
       which is what paper has room for. The connectors are percentage-based, so a taller cell keeps them
       aligned. */
    .dm-name,
    .dm-feeder {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .dm-slot {
      background: none;
      border-color: #000;
    }
    /* The winner's accent bar is an inset shadow, which a browser drops with the background graphics — so on
       paper the mark is a thick border plus the check. The loser's line stays fully inked for the same
       reason: greyed text photocopies to nothing, and the winner is already marked twice. */
    .dm-slot--winner {
      border-left-width: 3px;
      box-shadow: none;
    }
    .dm-slot--loser {
      opacity: 1;
    }
    .dm-when,
    .dm-games,
    .dm-outcome,
    .dm-lk,
    .dm-check,
    .dm-round__label,
    .dm-round__count,
    .dm-legend {
      color: #000;
    }
    .dm-seedno,
    .dm-live,
    .dm-legend__chip--seed {
      background: none;
      border: 1px solid #000;
      color: #000;
    }
    /* No cell is ever cut in half by a page break; a column keeps together where it fits on one. */
    .dm-match {
      break-inside: avoid;
    }
    .dm-round {
      break-inside: avoid;
    }
  }
</style>

<script>
  import { hc } from 'hono/client'
  import { indexScheduleByNode } from '../../shared'
  import { renderLive } from './tournament-draw.live'
  import { renderPreview, renderReveal } from './tournament-draw.render'
  import { drawSelection, drawSelectionParams } from './tournament-draw.url'
  import type { AppType } from '../../worker/app'
  import type { Entry, Segment } from './tournament-draw.render'
  import type { ParticipantsResponse, PublicCompetitionBracket, ScheduleResponse } from '../../shared'

  // The public bracket controller (ADR-0046): fetch → state → poll → per-panel dispatch. All the DOM
  // building lives in ./tournament-draw.render; this script only decides which renderer each panel gets
  // (preview / reveal / live) and keeps the segment + feed state the renderers read.
  const client = hc<AppType>(location.origin)

  // The public bracket polls ~1.5 s during the live show — fast enough that a revealed lot or a fresh
  // result appears within a step, light enough for a phone on event Wi-Fi (small N, ADR-0021).
  const POLL_MS = 1500

  const root = document.querySelector<HTMLElement>('[data-draw]')

  // The selected segment (Hauptrunde / Nebenrunde) per live competition — persisted across polls so a
  // re-render keeps the chosen tab. Defaults to the main bracket; only set on a field with a consolation.
  const segmentByComp = new Map<string, Segment>()

  // The selected round per live competition (#312) — the phone's position inside the chosen bracket, kept
  // here for the same reason as the segment: a poll every 1.5 s must not walk a reader back to round 1. It
  // is deliberately *not* reset when the segment changes; the view clamps it into whichever bracket is shown,
  // so switching to a shallower consolation lands on its last round rather than on an empty panel.
  const roundByComp = new Map<string, number>()

  // The reader's three choices in the address (#313), so a reload keeps the view and a copied URL opens the
  // same one at somebody else's end. What the parameters mean lives in ./tournament-draw.url; this only says
  // *when* they are written — and that is **only on a click**, never on a render.
  //
  // The reason is the same one /spielplan's filter has (#310): a render's effective view is a verdict about
  // the feed of *this* poll — a field whose draw has not landed yet shows the main bracket at round 1 — and
  // letting that rewrite the address would quietly strip the round out of a link somebody shared. The three
  // parameters are written together, because they describe one view and a link with two of them is a link
  // that only half works.
  const writeSelectionToUrl = (slug: string) => {
    const url = new URL(location.href)
    const params = drawSelectionParams({
      competition: slug,
      segment: segmentByComp.get(slug) ?? 'main',
      round: roundByComp.get(slug) ?? 1
    })
    // Set rather than replace the query: the page is the front door and may carry parameters of its own
    // (a campaign tag on a shared link), and the draw has no business dropping them.
    for (const [key, value] of Object.entries(params)) url.searchParams.set(key, value)
    history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`)
  }

  // Latest of each feed; the panels re-render from both whenever either arrives (a competition switches
  // from preview → reveal → live results over its lifetime). `lastBracketsJson` lets the 1.5 s poll skip a
  // full DOM rebuild when nothing changed between polls — no flicker between revealed lots or live results.
  let participants: ParticipantsResponse = { enabled: false, participants: [] }
  let brackets: PublicCompetitionBracket[] = []
  let lastBracketsJson = ''
  let schedule: ScheduleResponse = { published: false, matches: [] }
  let lastScheduleJson = ''

  // The wire's per-field strength-redaction decision (ADR-0048), learned from whichever feed carries the
  // field — the participants list before a draw, the bracket feed once drawn. The client renders this flag
  // instead of re-deriving a field's protection from its slug; every panel and the seed legend read it here.
  const redactedByComp = new Map<string, boolean>()

  // The seed legend item explains the LK-based seed badge — meaningless on a redacted field, whose bracket
  // suppresses the badge. Show it for the selected tab only once the wire says that field is *not* redacted.
  // The default is fail-safe: an unknown field (its feed hasn't loaded, or it has no confirmed entrants yet)
  // is treated as redacted, so a protected field never advertises strength („nach Leistungsklasse gesetzt")
  // in the gap before its `redacted: false` arrives — the leak the old synchronous slug guard couldn't have.
  // Re-run on every render (the flag may only arrive with the feeds) and on every tab switch.
  // The field on screen: the selected tab, or — once the filter is down to a single option and no longer
  // renders (ADR-0062) — the one panel that is left.
  const selectedSlug = (): string | undefined =>
    root?.querySelector<HTMLElement>('[data-tab][aria-selected="true"]')?.dataset.tab ??
    root?.querySelector<HTMLElement>('[data-panel]:not([hidden])')?.dataset.panel

  const syncSeedLegend = () => {
    if (!root) return
    const seedLegend = root.querySelector<HTMLElement>('[data-legend-seed]')
    const slug = selectedSlug()
    if (seedLegend && slug !== undefined) seedLegend.hidden = redactedByComp.get(slug) ?? true
  }

  const render = () => {
    if (!root) return
    const byComp = new Map<string, Entry[]>()
    if (participants.enabled) {
      for (const e of participants.participants) {
        const arr = byComp.get(e.competition) ?? []
        arr.push(e)
        byComp.set(e.competition, arr)
      }
    }
    // One topology index over the whole feed (#159) for the **reveal** phase's court/time caption — the
    // publish/reveal gates already filtered the matches, so a node simply isn't here when it shouldn't show
    // its time. The live phase reads the feed itself (see `renderLive`).
    const scheduleIndex = indexScheduleByNode(schedule.matches)
    const bracketByComp = new Map(brackets.map(b => [b.competition as string, b]))
    // Learn each field's redaction decision from the wire: the participants list carries it per row, the
    // bracket feed per bracket (main = consolation for a field). Both agree per competition (ADR-0048).
    redactedByComp.clear()
    for (const [slug, entries] of byComp) if (entries[0]) redactedByComp.set(slug, entries[0].redacted)
    for (const b of brackets) redactedByComp.set(b.competition, b.phase === 'live' ? b.main.redacted : b.redacted)
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel => {
      const slug = panel.dataset.panel!
      const bracket = panel.querySelector<HTMLElement>('[data-bracket]')
      const segmentsEl = panel.querySelector<HTMLElement>('[data-segments]')
      const roundsEl = panel.querySelector<HTMLElement>('[data-rounds]')
      if (!bracket || !segmentsEl || !roundsEl) return
      const entry = bracketByComp.get(slug)
      // Fully revealed → live results (segment control + resolved brackets); still revealing → reveal steps;
      // not yet drawn → the provisional preview. Redaction is read from the wire per phase — the live
      // bracket's flag, the reveal's flag, or (before any draw) the participants feed. The segment control
      // belongs to the live phase only; the segment state + re-render live here so a switch survives the poll.
      if (entry && entry.phase === 'live') {
        renderLive(
          { segments: segmentsEl, rounds: roundsEl, bracket },
          entry,
          // The whole feed, not the per-node index: the cell footer states a floor („im Anschluss · nicht
          // vor ca. 14:00", ADR-0069), which depends on the court's other reservations — including matches
          // of fields this tree never draws. The score is not taken from here (ADR-0070).
          schedule,
          { segment: segmentByComp.get(slug) ?? 'main', round: roundByComp.get(slug) ?? 1 },
          {
            segment: seg => {
              segmentByComp.set(slug, seg)
              writeSelectionToUrl(slug)
              render()
            },
            round: round => {
              roundByComp.set(slug, round)
              writeSelectionToUrl(slug)
              render()
            }
          }
        )
        return
      }
      segmentsEl.hidden = true
      roundsEl.hidden = true
      if (entry && entry.phase === 'revealing') renderReveal(bracket, entry, entry.redacted, scheduleIndex)
      else {
        const players = byComp.get(slug) ?? []
        // Same fail-safe default as the legend: an unknown field is treated as redacted. In practice a
        // preview with ≥4 players always has its slug in the map (it was populated from those very rows),
        // so this default only bites the empty-field case, which draws no strength anyway.
        renderPreview(bracket, players, redactedByComp.get(slug) ?? true)
      }
    })
    // The flag may only arrive with the feeds, so re-sync the seed legend for the selected tab each render.
    syncSeedLegend()
  }

  // The tabs are read from the live DOM on every use, never captured: a cancelled field's tab leaves
  // the filter after the wiring (ADR-0062), and a captured array would keep steering arrow keys onto a
  // detached button.
  const tabsNow = () => [...(root?.querySelectorAll<HTMLButtonElement>('[data-tab]') ?? [])]

  const selectTab = (slug: string) => {
    if (!root) return
    tabsNow().forEach(t => t.setAttribute('aria-selected', String(t.dataset.tab === slug)))
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => (p.hidden = p.dataset.panel !== slug))
    // Sync the seed legend to the newly-selected tab, reading the wire's redaction flag (ADR-0048).
    syncSeedLegend()
  }

  // A reader picking a field — the tab *and* the address, so the choice survives a reload and travels in a
  // link. Distinct from `selectTab`, which is also the way a cancelled field hands its selection to a
  // survivor (ADR-0062); that is the page repairing itself, not a choice, and it must not overwrite the
  // address a shared link arrived with.
  const chooseTab = (slug: string) => {
    selectTab(slug)
    writeSelectionToUrl(slug)
  }

  const initTabs = () => {
    const tabs = tabsNow()
    tabs.forEach(tab => {
      tab.addEventListener('click', () => chooseTab(tab.dataset.tab!))
      tab.addEventListener('keydown', e => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return
        e.preventDefault()
        const live = tabsNow()
        const i = live.indexOf(tab)
        const next = (i + (e.key === 'ArrowRight' ? 1 : live.length - 1)) % live.length
        live[next].focus()
        chooseTab(live[next].dataset.tab!)
      })
    })
    // What the address asks for (#313), read against the fields that actually have a tab — so a link to a
    // field with no draw, or to no field at all, lands on the server-rendered tab (the championship) rather
    // than on nothing. The bracket and the round are adopted for whichever field that turns out to be, and
    // then degraded per render by `bracketView` — a round past the final, or a consolation on a field that
    // has none. A field cancelled since the link was written loses its tab a moment later (ADR-0062); the
    // survivor it hands the selection to starts at its own outermost round, which is the honest default for
    // a bracket nobody asked to see.
    const asked = drawSelection(
      location.search,
      tabs.map(t => t.dataset.tab!)
    )
    // Select the tab the address names, else the server-rendered initial one (first tab = championship). The
    // seed legend stays hidden until a feed confirms the field is not redacted (fail-safe, ADR-0048); on the
    // championship tab it appears with the first participants fetch, alongside the rest of the bracket
    // populating.
    const initial =
      tabs.find(t => t.dataset.tab === asked.competition) ??
      tabs.find(t => t.getAttribute('aria-selected') === 'true') ??
      tabs[0]
    if (!initial) return
    const slug = initial.dataset.tab!
    segmentByComp.set(slug, asked.segment)
    roundByComp.set(slug, asked.round)
    // `selectTab`, not `chooseTab`: arriving on the page is not a choice, and a visitor who never touched a
    // control should not have three parameters appear in their address bar.
    selectTab(slug)
  }

  // The competition filter degrades with the cancellations (ADR-0062). Its options are enumerated from
  // the static competition list, so a cancelled field keeps its tab even though no wire fills its panel
  // any more — the tab and the panel are dropped outright here, and a filter left with a single option
  // does not render at all: with one field there is nothing to choose between, and the lone panel is the
  // surface. The tabs are wired first and this runs after its read resolves — a filter that only works
  // once the network answers would be worse than one option too many. Fail-open on a read error, like
  // every other public read: a transient failure must never take a running field off the page.
  //
  // This is the front door *applying* the decision, not a surface re-deriving it (ADR-0062 §4 and the
  // carve-out CONTEXT.md records): these tabs are enumerated statically at build time, exactly like the
  // competition cards. Deriving them from the feeds instead — the way /spielplan's filter legitimately
  // does — would tie a field's tab to its having rows, and a not-yet-drawn field with no confirmed
  // entries (or any field at all while the participant list's kill-switch is off) would lose its
  // preview with it.
  const dropCancelledTabs = async () => {
    if (!root) return
    let cancelled: readonly string[] = []
    try {
      const res = await client.api.phase.$get()
      if (res.ok) cancelled = (await res.json()).cancelledCompetitions
    } catch {
      return
    }
    for (const slug of cancelled) {
      root.querySelector(`[data-tab="${slug}"]`)?.remove()
      root.querySelector(`[data-panel="${slug}"]`)?.remove()
    }
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')]
    if (panels.length < 2) {
      root.querySelector('[data-tabs]')?.remove()
      // The lone panel is the surface now, not a tab's panel: it shows unconditionally and drops the
      // tab roles, whose `aria-labelledby` would otherwise point at a button that no longer exists.
      panels.forEach(panel => {
        panel.hidden = false
        panel.removeAttribute('role')
        panel.removeAttribute('aria-labelledby')
      })
      return
    }
    // A cancelled field may have been the selected tab — hand the selection to a survivor rather than
    // leave the surface with no panel showing.
    if (!root.querySelector('[data-panel]:not([hidden])')) selectTab(panels[0].dataset.panel!)
  }

  // The participant feed seeds the pre-draw preview; it changes rarely, so it loads once (and on a
  // tab-return). A failure here is the one that hides the whole surface — without it there is nothing
  // to show before any draw.
  const loadParticipants = async () => {
    if (!root) return
    try {
      const res = await client.api.participants.$get()
      if (!res.ok) throw new Error('bad status')
      participants = await res.json()
      root.classList.remove('is-error')
      render()
    } catch {
      root.classList.add('is-error')
    }
  }

  // The bracket feed drives the live bracket (reveal steps while revealing, resolved results once fully
  // revealed); it is polled. A transient poll failure keeps the last good state on screen (the show must
  // not flash an error mid-reveal) — the error surface is owned by loadParticipants, so a flaky poll never
  // blanks the page.
  const loadDraws = async () => {
    try {
      const res = await client.api.draw.$get()
      if (!res.ok) return
      const body = await res.json()
      // Skip the rebuild when nothing changed since the last poll — the common case between lots/results.
      const sig = JSON.stringify(body.brackets)
      if (sig === lastBracketsJson) return
      lastBracketsJson = sig
      brackets = body.brackets as PublicCompetitionBracket[]
      render()
    } catch {
      /* keep the last good bracket on a transient poll failure */
    }
  }

  // The schedule feed annotates each placed matchup with its court + „ca." time (#159). Polled alongside
  // the reveal; like it, a transient failure keeps the last good state (a flaky poll never blanks the
  // bracket — loadParticipants owns the error surface). The publish + reveal-cursor gates live server-side,
  // so a still-private or not-yet-revealed schedule returns no usable node and the bracket shows no time.
  const loadSchedule = async () => {
    try {
      const res = await client.api.schedule.$get()
      if (!res.ok) return
      const body = await res.json()
      const sig = JSON.stringify(body)
      if (sig === lastScheduleJson) return
      lastScheduleJson = sig
      schedule = body
      render()
    } catch {
      /* keep the last good schedule on a transient poll failure */
    }
  }

  const poll = () => {
    loadDraws()
    loadSchedule()
  }

  let timer: ReturnType<typeof setInterval> | undefined
  const startPolling = () => {
    if (timer === undefined) timer = setInterval(poll, POLL_MS)
  }
  const stopPolling = () => {
    if (timer !== undefined) {
      clearInterval(timer)
      timer = undefined
    }
  }

  initTabs()
  // The cancelled fields leave the filter as soon as the phase read answers; the wiring above does not
  // wait on it, so the tabs work from the first paint either way.
  dropCancelledTabs()
  loadParticipants()
  poll()
  startPolling()
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      loadParticipants()
      poll()
      startPolling()
    } else {
      stopPolling()
    }
  })
</script>
