---
// Shared motion system for the public marketing surfaces. The front door (index.astro) keeps its own
// inline copy of these styles; this component exists so the Damen validation-probe porch
// (porch-damen.astro) can reuse the front door's section rhythm — `SectionHeader`, `.reveal`, `.sect`
// headline clip-reveals — without re-declaring them. Drop `<ScrollMotion />` into the porch and use
// `.enter`/`.enter--N`, `.reveal`, `.sect` + `.sect__headline-clip`, `.stagger`, and the `.hero__title`
// / `.hero-date` hero devices. Only the Damen porch uses it; the front door keeps its own inline copy.
---

<style is:global>
  /* Hero head: date stacked above title on mobile, top-right on desktop */
  .hero-head {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 14px;
  }
  @media (min-width: 768px) {
    .hero-head {
      display: block;
      position: relative;
    }
  }
  .hero-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 0.9;
  }
  @media (min-width: 768px) {
    .hero-date {
      position: absolute;
      top: 0;
      right: 0;
      align-items: flex-end;
    }
  }
  .hero-date__wd {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 2px;
  }
  .hero-date__big {
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 0.86;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .hero__title > span {
    display: block;
    will-change: clip-path;
  }
  .hero__title .enter {
    animation-name: clipReveal;
    animation-duration: 0.7s;
  }

  /* Section headline clip reveal */
  .sect__headline-clip {
    opacity: 0;
    clip-path: inset(100% 0 0 0);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      clip-path 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 0.12s);
  }
  .sect.is-visible .sect__headline-clip {
    opacity: 1;
    /* negative top inset so umlaut dots (Ä/Ö/Ü) aren't sheared by the clip box */
    clip-path: inset(-0.22em 0 0 0);
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0s);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero entrance */
  .enter {
    animation: enterUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .enter--1 {
    animation-delay: 0.1s;
  }
  .enter--2 {
    animation-delay: 0.2s;
  }
  .enter--3 {
    animation-delay: 0.35s;
  }
  .enter--4 {
    animation-delay: 0.55s;
  }
  .enter--5 {
    animation-delay: 0.7s;
  }
  .enter--6 {
    animation-delay: 0.85s;
  }
  .enter--7 {
    animation-delay: 1s;
  }

  @keyframes enterUp {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes clipReveal {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0;
    }
    to {
      clip-path: inset(-0.2em -0.2em 0 0);
      opacity: 1;
    }
  }

  /* Card stagger for .cat-grid */
  .stagger {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 0.08s);
  }
  .cat-grid.is-visible .stagger {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .enter {
      animation: none;
    }
    .reveal,
    .sect__headline-clip,
    .stagger {
      opacity: 1;
      transform: none;
      clip-path: none;
      transition: none;
    }
  }
</style>

<!-- The motion above hides before it shows, so with scripting off nothing ever gets `is-visible` and the
     porch is a blank page. The content is the point; the animation is the garnish. -->
<noscript>
  <style>
    .reveal,
    .sect__headline-clip,
    .stagger {
      opacity: 1;
      transform: none;
      clip-path: none;
    }
  </style>
</noscript>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      // Position, not proportion. A ratio threshold asks „how much of this element is on screen", which an
      // element taller than the viewport can only ever answer up to `viewportHeight / elementHeight` — on a
      // short phone screen a tall section cannot reach 0.15 at all, and stays at `opacity: 0`. A trigger
      // line 15% up from the bottom edge reads the same for a one-line paragraph and for a tall section.
      { threshold: 0, rootMargin: '0px 0px -15% 0px' }
    )
    const targets = [...document.querySelectorAll('.reveal, .sect, .cat-grid')]
    targets.forEach(el => observer.observe(el))

    // A fragment load lands the reader deep in the page, and that jump can settle *after* the observer has
    // reported on the old scroll position — leaving something the reader is looking straight at at
    // `opacity: 0` until a stray scroll nudges it loose. Sweep once, when loading is done. (index.astro
    // runs its own copy of this observer and the same sweep.)
    window.addEventListener(
      'load',
      () => {
        targets.forEach(el => {
          const box = el.getBoundingClientRect()
          if (box.top < window.innerHeight && box.bottom > 0) el.classList.add('is-visible')
        })
      },
      { once: true }
    )
  }
</script>
